---
import "@styles/theme.css";

import Breakpoints from "@components/devtools/Breakpoints.astro";
import Head from "@components/layout/head/Head.astro";
import SchemaWebSite from "@components/seo/schema/WebSite.astro";
import WebComponents from "@components/layout/footer/WebComponents.astro";
import Selection from "@components/gimmicks/Selection.astro";
import setup from "@data/setup.json" with { type: "json" };

const { post, extraHtmlClasses = "", extraBodyClasses = "", frontmatter } = Astro.props;

// html classes
const htmlClasses = [
  "h-full",
  "scroll-smooth", // smooth scrolling fall back for Lenis.js
  "bg-olive-50 dark:bg-olive-950",
  "text-gray-900 dark:text-gray-100",
  extraHtmlClasses,
]
  .filter(Boolean)
  .join(" ");

// body classes
const bodyClasses = [
  "typography-ui", // base typography for UI elements outside of reading area
  "min-h-screen",
  "overflow-y-scroll", // always show scrollbar to prevent layout shift
  "bg-olive-50 dark:bg-olive-950",
  "text-gray-900 dark:text-gray-100",
  extraBodyClasses,
]
  .filter(Boolean)
  .join(" ");

const IS_DEV = import.meta.env.DEV;
---

<!doctype html>
<html lang="en" class={htmlClasses} transition:name="root" transition:animate="initial">
  <head>
    <Head post={post} frontmatter={frontmatter} />
    {import.meta.env.DEV && <link rel="stylesheet" href="/src/styles/auditor.css" />}
  </head>
  <body class={bodyClasses}>
    <slot />
    <Breakpoints />
    <SchemaWebSite />
    <script is:inline define:vars={{ IS_DEV, setup }}>
      (function () {
        if (typeof window === "undefined" || IS_DEV) return;

        const _paq = (window._paq = window._paq || []);
        const u = setup.search.instance;

        _paq.push(["setSiteId", setup.search.siteId]);
        _paq.push(["setTrackerUrl", u + "matomo.php"]);
        _paq.push(["setCookieDomain", setup.search.cookieDomain]);
        _paq.push(["enableLinkTracking"]);

        const loadMatomo = () => {
          const g = document.createElement("script");
          g.async = true;
          g.defer = true;
          g.src = u + "matomo.js";
          const target = document.head || document.body || document.documentElement;
          target.appendChild(g);
        };

        // Defer loading the tracking script until the page is actually activated.
        // Avoids a wasted network request for speculative prerender loads that the
        // user never visits.
        if (document.prerendering) {
          document.addEventListener("prerenderingchange", loadMatomo, { once: true });
        } else {
          loadMatomo();
        }
      })();
    </script>
    <script>
      document.addEventListener("astro:after-swap", () => {
        window.scrollTo({ left: 0, top: 0, behavior: "instant" });
      });
    </script>
    <script is:inline>
      (() => {
        const releaseNavigationLocks = () => {
          document.documentElement.classList.remove("astro-transitioning");
          document.documentElement.removeAttribute("inert");
          document.body?.removeAttribute("inert");
        };

        const applyNavigationLocks = () => {
          document.documentElement.classList.add("astro-transitioning");
          document.body?.setAttribute("inert", "");
        };

        // Locks interaction with the outgoing page for the duration of the
        // view transition, so clicks/scrolling can't land mid-swap.
        document.addEventListener("astro:before-preparation", applyNavigationLocks);
        document.addEventListener("astro:after-swap", releaseNavigationLocks);
        window.addEventListener("pageshow", releaseNavigationLocks);
      })();
    </script>
    <script>
      import Lenis from "lenis";

      (() => {
        /**
         * Keep a single Lenis instance across swaps.
         * Store it on window.kdev to avoid duplicate initialisations.
         */
        const getNamespace = () => {
          if (!window.kdev || typeof window.kdev !== "object") window.kdev = {};
          return window.kdev;
        };

        const destroyLenis = () => {
          const ns = getNamespace();
          const existing = ns.lenis;
          if (existing && typeof existing === "object" && "destroy" in existing) {
            try {
              const destroyable = existing as { destroy: () => void };
              destroyable.destroy();
            } catch (e) {
              console.error("[lenis] destroy failed", e);
            }
          }
          ns.lenis = undefined;
        };

        const initLenis = () => {
          const ns = getNamespace();

          // Avoid stacking multiple Lenis instances and wheel listeners.
          destroyLenis();

          // Respect prefers-reduced-motion: leave Lenis uninitialised and fall
          // back to the native "scroll-smooth" class already on <html>.
          if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
            return;
          }

          try {
            const lenis = new Lenis({
              autoRaf: true,
              // Let nested scrollable regions (e.g. the Pagefind results
              // dropdown) capture wheel input instead of the page.
              allowNestedScroll: true,
            });

            // Some bfcache restores benefit from forcing a sync.
            // resize exists in newer Lenis versions; check before calling.
            if (typeof lenis.resize === "function") {
              lenis.resize();
            }

            // start exists in some versions. If present, ensure it is not paused.
            if (typeof lenis.start === "function") {
              lenis.start();
            }

            ns.lenis = lenis;
          } catch (e) {
            console.error("[lenis] init failed", e);
          }
        };

        // Do not initialise Lenis in a speculative prerender — the page is not
        // yet visible and the scroll context is meaningless. Defer to activation.
        // document.prerendering is not yet in TypeScript's DOM lib.
        const isPrerendering = "prerendering" in document && (document as Document & { prerendering: boolean }).prerendering;
        if (isPrerendering) {
          document.addEventListener("prerenderingchange", initLenis, { once: true });
        } else {
          initLenis();
        }

        // Runs after every ClientRouter navigation.
        document.addEventListener("astro:page-load", () => {
          initLenis();
        });

        // Runs on bfcache restore (Back/Forward).
        window.addEventListener("pageshow", () => {
          initLenis();
        });
      })();
    </script>
    <script>
      /**
       * Drives the animated rule/underline that CSS draws under every
       * heading and prose <hr> (see `theme.css`'s "Animated rule system").
       * CSS alone ships the line pre-drawn at 40% length; this only (a)
       * tells each heading which edge to grow from, based on its *computed*
       * text-align so inherited alignment (e.g. a centered ancestor
       * section) still resolves correctly, and (b) extends the line to
       * full length the first time it scrolls into view.
       */
      (() => {
        const RULE_SELECTOR = "h1, h2, h3, h4, h5, h6, .typography-reading hr";

        const getNamespace = () => {
          if (!window.kdev || typeof window.kdev !== "object") window.kdev = {};
          return window.kdev;
        };

        const originForAlign = (align: string) => {
          if (align === "right" || align === "end") return "right";
          if (align === "center") return "center";
          return "left";
        };

        const initRuleLines = () => {
          const ns = getNamespace();

          // Drop the previous observer before re-scanning after a ClientRouter swap.
          if (ns.ruleObserver && typeof ns.ruleObserver.disconnect === "function") {
            ns.ruleObserver.disconnect();
          }

          // Reduced motion: CSS already shows the line fully extended and
          // skips the transition, so there is nothing left for JS to do.
          if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
            return;
          }

          const elements = document.querySelectorAll(RULE_SELECTOR);
          if (elements.length === 0) return;

          const observer = new IntersectionObserver(
            (entries, obs) => {
              for (const entry of entries) {
                if (!entry.isIntersecting) continue;
                entry.target.classList.add("rule-visible");
                obs.unobserve(entry.target);
              }
            },
            { threshold: 0.1, rootMargin: "0px 0px -10% 0px" },
          );

          for (const el of elements) {
            if (el.tagName !== "HR" && el instanceof HTMLElement) {
              el.style.setProperty("--rule-origin", originForAlign(getComputedStyle(el).textAlign));
            }
            observer.observe(el);
          }

          ns.ruleObserver = observer;
        };

        document.addEventListener("astro:page-load", initRuleLines);
      })();
    </script>
    <WebComponents post={post} />
    <script>
      import "@tailwindplus/elements";
    </script>
    <Selection />
  </body>
</html>
