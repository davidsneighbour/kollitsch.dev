---
export interface Props {
  classes?: string;
}

const { classes = "progress z-40 relative [--height:4px] lg:[--height:6px]" }: Props = Astro.props;
---

<div
  class={classes}
  role="progressbar"
  aria-valuemin="0"
  aria-valuemax="100"
  aria-valuenow="0"
  aria-label="Reading progress"
  data-reading-progress
>
  <div class="progress-fill"></div>
</div>
<script is:inline>
  (() => {
    window.kdev ??= {};

    if (window.kdev.readingProgressInitialised) {
      return;
    }

    window.kdev.readingProgressInitialised = true;

    const getScroll = () => {
      const d = document.documentElement;
      const b = document.body;
      const top = d.scrollTop || b.scrollTop;
      const height = (d.scrollHeight || b.scrollHeight) - d.clientHeight;
      return height > 0 ? (top / height) * 100 : 0;
    };

    const updateProgress = () => {
      const scroll = getScroll();
      const progressBars = document.querySelectorAll("[data-reading-progress]");

      for (const progress of progressBars) {
        if (!(progress instanceof HTMLElement)) {
          continue;
        }

        progress.setAttribute("aria-valuenow", String(Math.round(scroll)));
        progress.style.setProperty("--scroll", String(scroll / 100));
        progress.toggleAttribute("data-complete", scroll >= 99.9);
      }
    };

    document.addEventListener("scroll", updateProgress, { passive: true });
    window.addEventListener("load", updateProgress);
    document.addEventListener("astro:page-load", updateProgress);

    updateProgress();
  })();
</script>

<style>
  @reference "@styles/theme.css";

  @keyframes progress-bar-stripes {
    0% {
      background-position-x: 0;
    }

    100% {
      background-position-x: var(--progress-height);
    }
  }

  .progress {
    --progress-height: var(--thickness, var(--height, 4px));
    --progress-bar-transition: transform 0.6s cubic-bezier(0.23, 1, 0.32, 1);
    --scroll: 0;

    @apply w-full overflow-hidden rounded-none bg-black/10;
    @apply shadow-[inset_0_1px_2px_rgba(0,0,0,0.075)];

    height: var(--progress-height);
  }

  .progress-fill {
    @apply absolute inset-y-0 left-0 h-full w-full origin-left rounded-full bg-brand-main-accent;

    background-image: linear-gradient(
      -45deg,
      rgba(255, 255, 255, 0.15) 25%,
      transparent 25%,
      transparent 50%,
      rgba(255, 255, 255, 0.15) 50%,
      rgba(255, 255, 255, 0.15) 75%,
      transparent 75%,
      transparent
    );
    background-size: var(--progress-height) var(--progress-height);
    animation: progress-bar-stripes 1s linear infinite;
    transform: scaleX(var(--scroll));
    transition: var(--progress-bar-transition);
  }

  @media (prefers-reduced-motion: reduce) {
    .progress-fill {
      @apply animate-none transition-none;
    }
  }

  .progress:not([data-complete]) .progress-fill {
    @apply rounded-l-none rounded-r-full;

    transition:
      var(--progress-bar-transition),
      border-radius 0.2s cubic-bezier(0.645, 0.045, 0.355, 1);
  }

  .progress[data-complete] .progress-fill {
    @apply rounded-none;

    transition:
      var(--progress-bar-transition),
      border-radius 0.2s cubic-bezier(0.645, 0.045, 0.355, 1);
  }
</style>
