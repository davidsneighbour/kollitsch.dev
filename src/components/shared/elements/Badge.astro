---
// @todo refactor and comment
export type BadgeVariant =
  | 'default'
  | 'secondary'
  | 'destructive'
  | 'outline'
  | 'ghost'
  | 'link'
  | 'green'
  | 'gray'
  | 'red';

export interface Props {
  /** shadcn-style badge variant */
  variant?: BadgeVariant;
  /** Legacy color theme of the badge */
  color?: 'gray' | 'red' | 'yellow';
  /** Whether the badge has a border (true) or flat background (false) */
  bordered?: boolean;
  /** Optional link: when present, render as <a> */
  href?: string;
  /** Optional extra Tailwind classes to append */
  class?: string;
  /** Optional accessible title/tooltip */
  title?: string;
  [key: string]: unknown;
}

const {
  variant,
  color,
  bordered = false,
  href,
  class: extraClass = '',
  title,
  ...attrs
} = Astro.props;

const resolvedVariant: BadgeVariant =
  variant ??
  (color === 'gray'
    ? 'gray'
    : color === 'yellow'
      ? 'green'
      : color === 'red'
        ? 'red'
        : bordered
          ? 'outline'
          : 'default');

const base =
  'inline-flex items-center justify-center gap-1 rounded-md px-1.5 pt-0.5 pb-0.75 text-xs font-medium whitespace-nowrap transition-colors [&_[data-icon]]:size-3.5 [&_[data-icon]]:shrink-0';

const variants: Record<BadgeVariant, string> = {
  default: 'bg-red-100 text-red-700 dark:bg-red-400/10 dark:text-red-400',
  destructive: 'bg-red-600 text-white dark:bg-red-600 dark:text-white',
  ghost: 'bg-transparent text-red-700 dark:text-red-500',
  gray: bordered
    ? 'bg-gray-50 text-gray-600 inset-ring inset-ring-gray-500/10 dark:bg-gray-400/10 dark:text-gray-400 dark:inset-ring-gray-400/20'
    : 'bg-gray-100 text-gray-600 dark:bg-gray-400/10 dark:text-gray-300',
  green:
    'bg-green-50 text-green-700 inset-ring inset-ring-green-700/20 dark:bg-green-950 dark:text-green-300 dark:inset-ring-green-400/20',
  link: 'bg-transparent px-0 text-red-700 underline-offset-4 hover:underline dark:text-red-500',
  outline:
    'bg-transparent text-red-700 inset-ring inset-ring-red-700/20 dark:text-red-500 dark:inset-ring-red-500/20',
  red: bordered
    ? 'bg-red-50 text-red-700 inset-ring inset-ring-red-600/10 dark:bg-red-400/10 dark:text-red-400 dark:inset-ring-red-400/20'
    : 'bg-red-100 text-red-700 dark:bg-red-400/10 dark:text-red-400',
  secondary: 'bg-gray-100 text-gray-600 dark:bg-gray-400/10 dark:text-gray-300',
};

const hoverVariants: Record<BadgeVariant, string> = {
  default:
    'hover:bg-red-100/80 hover:text-red-800 dark:hover:bg-red-400/20 dark:hover:text-red-300',
  destructive: 'hover:bg-red-700 dark:hover:bg-red-700',
  ghost:
    'hover:bg-red-700/10 hover:text-orange-700 dark:hover:bg-red-500/20 dark:hover:text-orange-400',
  gray: 'hover:bg-gray-100/80 hover:text-gray-700 dark:hover:bg-gray-400/20 dark:hover:text-gray-200',
  green:
    'hover:bg-green-100 hover:text-green-700 dark:hover:bg-green-950 dark:hover:text-green-300',
  link: 'hover:text-orange-700 dark:hover:text-orange-400',
  outline:
    'hover:bg-red-700/10 hover:text-orange-700 dark:hover:bg-red-500/20 dark:hover:text-orange-400',
  red: 'hover:bg-red-100/80 hover:text-red-800 dark:hover:bg-red-400/20 dark:hover:text-red-300',
  secondary:
    'hover:bg-gray-100/80 hover:text-gray-700 dark:hover:bg-gray-400/20 dark:hover:text-gray-200',
};

const focusVariants: Record<BadgeVariant, string> = {
  default:
    'focus:outline-none focus-visible:ring-2 focus-visible:ring-red-500/50 focus-visible:ring-offset-2 focus-visible:ring-offset-white dark:focus-visible:ring-red-400/40 dark:focus-visible:ring-offset-gray-950',
  destructive:
    'focus:outline-none focus-visible:ring-2 focus-visible:ring-red-500/50 focus-visible:ring-offset-2 focus-visible:ring-offset-white dark:focus-visible:ring-red-400/40 dark:focus-visible:ring-offset-gray-950',
  ghost:
    'focus:outline-none focus-visible:ring-2 focus-visible:ring-red-500/50 focus-visible:ring-offset-2 focus-visible:ring-offset-white dark:focus-visible:ring-red-400/40 dark:focus-visible:ring-offset-gray-950',
  gray: 'focus:outline-none focus-visible:ring-2 focus-visible:ring-gray-400/50 focus-visible:ring-offset-2 focus-visible:ring-offset-white dark:focus-visible:ring-gray-300/40 dark:focus-visible:ring-offset-gray-950',
  green:
    'focus:outline-none focus-visible:ring-2 focus-visible:ring-green-600/50 focus-visible:ring-offset-2 focus-visible:ring-offset-white dark:focus-visible:ring-green-300/40 dark:focus-visible:ring-offset-gray-950',
  link: 'focus:outline-none focus-visible:ring-2 focus-visible:ring-red-500/50 focus-visible:ring-offset-2 focus-visible:ring-offset-white dark:focus-visible:ring-red-400/40 dark:focus-visible:ring-offset-gray-950',
  outline:
    'focus:outline-none focus-visible:ring-2 focus-visible:ring-red-500/50 focus-visible:ring-offset-2 focus-visible:ring-offset-white dark:focus-visible:ring-red-400/40 dark:focus-visible:ring-offset-gray-950',
  red: 'focus:outline-none focus-visible:ring-2 focus-visible:ring-red-500/50 focus-visible:ring-offset-2 focus-visible:ring-offset-white dark:focus-visible:ring-red-400/40 dark:focus-visible:ring-offset-gray-950',
  secondary:
    'focus:outline-none focus-visible:ring-2 focus-visible:ring-gray-400/50 focus-visible:ring-offset-2 focus-visible:ring-offset-white dark:focus-visible:ring-gray-300/40 dark:focus-visible:ring-offset-gray-950',
};

const variantClasses = variants[resolvedVariant];
const hoverClasses = href ? hoverVariants[resolvedVariant] : '';
const focusClasses = href ? focusVariants[resolvedVariant] : '';
const classes =
  `${base} ${variantClasses} ${hoverClasses} ${focusClasses} ${extraClass}`.trim();
---

{href ? (
    <a
      {...attrs}
      href={href}
      class={classes}
      title={title}
      aria-label={title}
    >
      <slot />
    </a>
  ) : (
    <span
      {...attrs}
      class={classes}
      title={title}
      aria-label={title}
    >
      <slot />
    </span>
  )}
