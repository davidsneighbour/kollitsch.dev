---
export type Props = {
  endpoint?: string;
  cacheHours?: number;
  class?: string;
  heading?: string;
};

const {
  endpoint = '/api/github-contributions',
  cacheHours = 24,
  class: className,
  heading = 'Recent GitHub activity',
} = Astro.props;
---

<section
  class:list={["github-contributions", className]}
  data-github-contributions
  data-endpoint={endpoint}
  data-cache-hours={cacheHours}
  aria-busy="true"
>
  <div class="github-contributions__header">
    <h2>{heading}</h2>
    <p
      class="github-contributions__summary"
      data-summary
      aria-live="polite"
    >
      Loading contributions…
    </p>
  </div>

  <div
    class="github-contributions__viewport"
    data-viewport
  >
    <div class="github-contributions__calendar">
      <div
        class="github-contributions__months"
        data-months
        aria-hidden="true"
      ></div>

      <div
        class="github-contributions__grid"
        data-grid
        role="grid"
        aria-label="GitHub contributions by day"
      ></div>
    </div>
  </div>

  <div
    class="github-contributions__tooltip"
    data-tooltip
    role="tooltip"
    hidden
  ></div>

  <p
    class="github-contributions__error"
    data-error
    hidden
  >
    GitHub activity is currently unavailable.
  </p>
</section>

<script>
  type ContributionLevel =
    | 'NONE'
    | 'FIRST_QUARTILE'
    | 'SECOND_QUARTILE'
    | 'THIRD_QUARTILE'
    | 'FOURTH_QUARTILE';

  type ContributionDay = {
    contributionCount: number;
    contributionLevel: ContributionLevel;
    date: string;
    weekday: number;
  };

  type ContributionWeek = {
    firstDay: string;
    contributionDays: ContributionDay[];
  };

  type ContributionData = {
    username: string;
    generatedAt: string;
    totalContributions: number;
    weeks: ContributionWeek[];
  };

  type CacheEntry = {
    cachedAt: number;
    data: ContributionData;
  };

  const CACHE_VERSION = 1;
  const formatter = new Intl.DateTimeFormat('en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });

  function isContributionData(value: unknown): value is ContributionData {
    if (!value || typeof value !== 'object') return false;

    const candidate = value as Partial<ContributionData>;

    return (
      typeof candidate.username === 'string' &&
      typeof candidate.generatedAt === 'string' &&
      typeof candidate.totalContributions === 'number' &&
      Array.isArray(candidate.weeks)
    );
  }

  function readCache(key: string, ttlMs: number): ContributionData | null {
    try {
      const raw = window.localStorage.getItem(key);
      if (!raw) return null;

      const parsed = JSON.parse(raw) as Partial<CacheEntry>;

      if (
        typeof parsed.cachedAt !== 'number' ||
        Date.now() - parsed.cachedAt >= ttlMs ||
        !isContributionData(parsed.data)
      ) {
        window.localStorage.removeItem(key);
        return null;
      }

      return parsed.data;
    } catch (error) {
      console.warn('Unable to read GitHub contribution cache.', error);
      return null;
    }
  }

  function writeCache(key: string, data: ContributionData): void {
    try {
      const entry: CacheEntry = {
        cachedAt: Date.now(),
        data,
      };

      window.localStorage.setItem(key, JSON.stringify(entry));
    } catch (error) {
      console.warn('Unable to write GitHub contribution cache.', error);
    }
  }

  async function fetchContributions(
    endpoint: string,
  ): Promise<ContributionData> {
    const response = await fetch(endpoint, {
      headers: {
        Accept: 'application/json',
      },
    });

    if (!response.ok) {
      throw new Error(
        `GitHub contributions endpoint returned ${response.status} ${response.statusText}.`,
      );
    }

    const data: unknown = await response.json();

    if (!isContributionData(data)) {
      throw new Error('GitHub contributions endpoint returned invalid data.');
    }

    return data;
  }

  function formatContributionLabel(day: ContributionDay): string {
    const date = formatter.format(new Date(`${day.date}T12:00:00Z`));
    const noun = day.contributionCount === 1 ? 'contribution' : 'contributions';

    return `${day.contributionCount} ${noun} on ${date}`;
  }

  function positionTooltip(
    root: HTMLElement,
    target: HTMLElement,
    tooltip: HTMLElement,
  ): void {
    const rootRect = root.getBoundingClientRect();
    const targetRect = target.getBoundingClientRect();
    const tooltipRect = tooltip.getBoundingClientRect();

    let left =
      targetRect.left -
      rootRect.left +
      targetRect.width / 2 -
      tooltipRect.width / 2;

    left = Math.max(0, Math.min(left, rootRect.width - tooltipRect.width));

    const top = targetRect.top - rootRect.top - tooltipRect.height - 8;

    tooltip.style.left = `${left}px`;
    tooltip.style.top = `${Math.max(0, top)}px`;
  }

  function showTooltip(
    root: HTMLElement,
    target: HTMLElement,
    tooltip: HTMLElement,
    label: string,
  ): void {
    tooltip.textContent = label;
    tooltip.hidden = false;

    requestAnimationFrame(() => {
      positionTooltip(root, target, tooltip);
    });
  }

  function hideTooltip(tooltip: HTMLElement): void {
    tooltip.hidden = true;
  }

  function renderCalendar(root: HTMLElement, data: ContributionData): void {
    const grid = root.querySelector<HTMLElement>('[data-grid]');
    const months = root.querySelector<HTMLElement>('[data-months]');
    const summary = root.querySelector<HTMLElement>('[data-summary]');
    const tooltip = root.querySelector<HTMLElement>('[data-tooltip]');

    if (!grid || !months || !summary || !tooltip) {
      throw new Error('GitHub contributions component markup is incomplete.');
    }

    grid.replaceChildren();
    months.replaceChildren();

    grid.style.setProperty('--week-count', String(data.weeks.length));
    months.style.setProperty('--week-count', String(data.weeks.length));

    let previousMonth = -1;

    data.weeks.forEach((week, weekIndex) => {
      const weekDate = new Date(`${week.firstDay}T12:00:00Z`);
      const month = weekDate.getUTCMonth();

      if (month !== previousMonth) {
        const label = document.createElement('span');
        label.className = 'github-contributions__month';
        label.textContent = new Intl.DateTimeFormat('en-GB', {
          month: 'short',
        }).format(weekDate);
        label.style.gridColumn = String(weekIndex + 1);
        months.append(label);
        previousMonth = month;
      }

      for (const day of week.contributionDays) {
        const dot = document.createElement('button');
        const label = formatContributionLabel(day);

        dot.type = 'button';
        dot.className = 'github-contributions__day';
        dot.dataset['level'] = day.contributionLevel;
        dot.style.gridColumn = String(weekIndex + 1);
        dot.style.gridRow = String(day.weekday + 1);
        dot.setAttribute('role', 'gridcell');
        dot.setAttribute('aria-label', label);

        dot.addEventListener('mouseenter', () => {
          showTooltip(root, dot, tooltip, label);
        });

        dot.addEventListener('mouseleave', () => {
          hideTooltip(tooltip);
        });

        dot.addEventListener('focus', () => {
          showTooltip(root, dot, tooltip, label);
        });

        dot.addEventListener('blur', () => {
          hideTooltip(tooltip);
        });

        grid.append(dot);
      }
    });

    const noun =
      data.totalContributions === 1 ? 'contribution' : 'contributions';

    summary.textContent = `${data.totalContributions.toLocaleString('en-GB')} ${noun} in the last year`;

    root.setAttribute('aria-busy', 'false');
  }

  async function initialise(root: HTMLElement): Promise<void> {
    const endpoint = root.dataset['endpoint'] ?? '/api/github-contributions';
    const cacheHours = Number(root.dataset['cacheHours'] ?? '24');
    const safeCacheHours =
      Number.isFinite(cacheHours) && cacheHours > 0 ? cacheHours : 24;

    const ttlMs = safeCacheHours * 60 * 60 * 1000;
    const cacheKey = `github-contributions:v${CACHE_VERSION}:${endpoint}`;

    const errorElement = root.querySelector<HTMLElement>('[data-error]');

    try {
      const cached = readCache(cacheKey, ttlMs);

      if (cached) {
        renderCalendar(root, cached);
        return;
      }

      const data = await fetchContributions(endpoint);
      writeCache(cacheKey, data);
      renderCalendar(root, data);
    } catch (error) {
      console.error('Unable to initialise GitHub contributions.', error);

      root.setAttribute('aria-busy', 'false');

      if (errorElement) {
        errorElement.hidden = false;
      }

      const summary = root.querySelector<HTMLElement>('[data-summary]');
      if (summary) {
        summary.textContent = 'Contribution data unavailable';
      }
    }
  }

  document
    .querySelectorAll<HTMLElement>('[data-github-contributions]')
    .forEach((root) => {
      void initialise(root);
    });
</script>

<style>
  .github-contributions {
    --github-activity-0: var(--color-surface-muted, #27272a);
    --github-activity-1: var(--color-accent-200, #a7f3d0);
    --github-activity-2: var(--color-accent-400, #34d399);
    --github-activity-3: var(--color-accent-600, #059669);
    --github-activity-4: var(--color-accent-800, #065f46);

    --github-activity-dot-size: 0.7rem;
    --github-activity-gap: 0.25rem;

    position: relative;
    width: 100%;
  }

  .github-contributions__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .github-contributions__header h2,
  .github-contributions__summary,
  .github-contributions__error {
    margin: 0;
  }

  .github-contributions__summary {
    color: var(--color-text-muted, currentColor);
    font-size: 0.875rem;
  }

  .github-contributions__viewport {
    overflow-x: auto;
    padding-bottom: 0.5rem;
  }

  .github-contributions__calendar {
    width: max-content;
    min-width: 100%;
  }

  .github-contributions__months,
  .github-contributions__grid {
    display: grid;
    grid-template-columns: repeat(
        var(--week-count, 53),
        var(--github-activity-dot-size)
      );
    column-gap: var(--github-activity-gap);
  }

  .github-contributions__months {
    min-height: 1.25rem;
    margin-bottom: 0.35rem;
    font-size: 0.7rem;
    color: var(--color-text-muted, currentColor);
  }

  .github-contributions__month {
    white-space: nowrap;
  }

  .github-contributions__grid {
    grid-template-rows: repeat(7, var(--github-activity-dot-size));
    row-gap: var(--github-activity-gap);
  }

  .github-contributions__day {
    width: var(--github-activity-dot-size);
    height: var(--github-activity-dot-size);
    padding: 0;
    border: 0;
    border-radius: 9999px;
    background: var(--github-activity-0);
    cursor: default;
  }

  .github-contributions__day[data-level="FIRST_QUARTILE"] {
    background: var(--github-activity-1);
  }

  .github-contributions__day[data-level="SECOND_QUARTILE"] {
    background: var(--github-activity-2);
  }

  .github-contributions__day[data-level="THIRD_QUARTILE"] {
    background: var(--github-activity-3);
  }

  .github-contributions__day[data-level="FOURTH_QUARTILE"] {
    background: var(--github-activity-4);
  }

  .github-contributions__day:hover,
  .github-contributions__day:focus-visible {
    outline: 2px solid var(--color-text, currentColor);
    outline-offset: 2px;
  }

  .github-contributions__tooltip {
    position: absolute;
    z-index: 10;
    width: max-content;
    max-width: min(20rem, 90vw);
    padding: 0.4rem 0.55rem;
    border-radius: 0.375rem;
    background: var(--color-text, #fafafa);
    color: var(--color-background, #18181b);
    font-size: 0.75rem;
    line-height: 1.3;
    pointer-events: none;
  }

  .github-contributions__error {
    margin-top: 0.75rem;
    color: var(--color-text-muted, currentColor);
    font-size: 0.875rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    .github-contributions__day {
      transition:
        transform 120ms ease,
        outline-color 120ms ease;
    }

    .github-contributions__day:hover,
    .github-contributions__day:focus-visible {
      transform: scale(1.2);
    }
  }
</style>
