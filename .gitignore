# Local scratch/working files (also ignored globally, but tracked here for portability)
/scratch

# Dev server external restart trigger (used by webserver.ts)
/RESTART

# mkcert-generated locally-trusted dev certificates
/.certs

# Playwright MCP local browser session/output dir
.playwright-mcp/

# Lychee cache
# @todo move into a sub folder
.lychee.report.md
.lycheecache

# vale config
src/config/vale/*
!src/config/vale/config
src/config/vale/config/templates/
src/config/vale/config/vocabularies/DNB
!src/config/vale/config/vocabularies/kollitsch-dev

# Local project-management working files (dnb-project-task-triage skill)
/PROJECT.md
/TODO.md

# AI assistant settings
.claude/settings*.json
/ai
.github/hooks
.codex

# Installed skills (reproducible via skills-lock.json / `npx skills add`)
# Manually authored AI assets belong in .agents/instructions or .agents/prompts, not here.
.claude/skills/
.codex/skills/
.github/skills/

# .agents/skills/: dnb-* skills are installed via `npx skills add` and reproducible
# via skills-lock.json, so they are ignored. kdev-* skills are authored in this repo
# and tracked.
.agents/skills/*
!.agents/skills/kdev-*

# Wireit cache
.wireit

# Local build artifact cache (og_image renders, build:profile logs)
/.cache

# impeccable skill: per-run dated critique reports and hook cache
.impeccable/critique/
.impeccable/hook.cache.json

# Dynamically generated files
public/_headers
public/og_image/
public/favicon.ico
public/dnb-*.rss.xml
src/content/_generated

# Created by https://www.toptal.com/developers/gitignore/api/node,astro
# Edit at https://www.toptal.com/developers/gitignore?templates=node,astro

### Astro ###
# Gitignore template for Astro projects
# Ignore content collection generated files
.astro

### Node ###
# Logs
logs
*.log
npm-debug.log*

# Lighthouse local reports (JSON + HTML output from lighthouse:* scripts)
reports/lighthouse/

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Coverage directory used by tools like istanbul/vitest
coverage
*.lcov

# Dependency directories
node_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional stylelint cache
.stylelintcache

# dotenv environment variable files
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# Astro build output
dist

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# End of https://www.toptal.com/developers/gitignore/api/node,astro

# TypeDoc generated API docs
documentation/api
