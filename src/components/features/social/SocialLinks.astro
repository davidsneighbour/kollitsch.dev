---
import IconLink from '@components/shared/links/IconLink.astro';
import {
  type SocialMediaNetwork,
  social,
  socialNetworksFor,
} from '@data/social.ts';
import { mergeRel } from '@utils/social.pure.ts';

export interface Props {
  container?: 'ul' | 'ol' | 'div' | 'menu';
  containerClass?: string;
  /** Networks to render. Defaults to the networks with `show.footer`. */
  items?: readonly SocialMediaNetwork[];
  target?: string;
}

const {
  container = 'ul',
  containerClass = 'flex flex-row flex-wrap justify-center gap-2 lg:justify-end',
  items = socialNetworksFor('footer'),
  target = social.defaults.target,
} = Astro.props as Props;

const Tag = container;
const ListTag = container === 'div' ? 'span' : 'li';
---

<Tag class={containerClass}>
  {items.map((network) => (
    <ListTag>
      <IconLink
        href={network.profile.url}
        icon={network.icon}
        target={target}
        rel={mergeRel(social.defaults.rel, network.profile.rel)}
        title={network.profile.title}
        class={`size-6 ${network.classes.fill}`}
      >
        {network.label}
      </IconLink>
    </ListTag>
  ))}
</Tag>
