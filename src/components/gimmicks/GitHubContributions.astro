---
export interface Props {
  endpoint?: string;
  cacheHours?: number;
  class?: string;
  heading?: string;
}
const {
  endpoint = '/api/github-contributions',
  cacheHours = 24,
  class: className,
  heading = 'Recent GitHub activity',
} = Astro.props;
---

<section
  class:list={['github-contributions', className]}
  aria-label={heading}
  aria-busy="true"
  data-contributions
  data-endpoint={endpoint}
  data-cache-hours={cacheHours}
>
  <slot name="heading"><h3>{heading}</h3></slot>
  <p
    aria-live="polite"
    data-summary
  >
    Loading GitHub activity...
  </p>
  <div
    class="overflow-x-auto py-4"
    data-calendar
    aria-hidden="true"
  ></div>
  <noscript
    ><p>Enable JavaScript to view the contribution calendar.</p></noscript
  >
</section>
<script>
  import { levels, loadContributions } from './github-contributions';

  async function render(root: HTMLElement): Promise<void> {
    const summary = root.querySelector<HTMLElement>('[data-summary]');
    const calendar = root.querySelector<HTMLElement>('[data-calendar]');
    if (!summary || !calendar) return;
    try {
      let storage: Storage | undefined;
      try {
        storage = window.localStorage;
      } catch {
        /* Storage can be blocked. */
      }
      const data = await loadContributions(
        root.dataset['endpoint'] ?? '/api/github-contributions',
        Number(root.dataset['cacheHours'] ?? 24),
        storage,
      );
      const monthFormat = new Intl.DateTimeFormat('en-GB', {
        month: 'short',
        timeZone: 'UTC',
      });
      const countFormat = new Intl.NumberFormat('en-GB');
      summary.textContent = `${countFormat.format(data.totalContributions)} ${data.totalContributions === 1 ? 'contribution' : 'contributions'} in the last year`;
      const grid = document.createElement('div');
      grid.className = 'github-contributions__grid';
      grid.style.setProperty('--weeks', String(data.weeks.length));
      let previousMonth = '';
      data.weeks.forEach((week, index) => {
        const date = new Date(`${week.contributionDays[0]?.date}T00:00:00Z`);
        const month = monthFormat.format(date);
        if (month !== previousMonth && index < data.weeks.length - 2) {
          const label = document.createElement('span');
          label.className = 'github-contributions__month';
          label.textContent = month;
          label.style.gridColumn = `${index + 1} / span 3`;
          label.style.gridRow = '1';
          grid.append(label);
          previousMonth = month;
        }
        for (const day of week.contributionDays) {
          const cell = document.createElement('span');
          cell.className = 'github-contributions__day';
          cell.dataset['level'] = String(
            levels.indexOf(day.contributionLevel),
          );
          cell.style.gridColumn = String(index + 1);
          cell.style.gridRow = String(day.weekday + 2);
          grid.append(cell);
        }
      });
      calendar.replaceChildren(grid);
    } catch {
      summary.textContent =
        'GitHub activity is unavailable. Please try again later.';
    } finally {
      root.setAttribute('aria-busy', 'false');
    }
  }
  function initialise(): void {
    for (const root of document.querySelectorAll<HTMLElement>(
      '[data-contributions]:not([data-initialised])',
    )) {
      root.dataset['initialised'] = 'true';
      if (!('IntersectionObserver' in window)) {
        void render(root);
        continue;
      }
      const observer = new IntersectionObserver(
        (entries) => {
          if (entries.some((entry) => entry.isIntersecting)) {
            observer.disconnect();
            void render(root);
          }
        },
        { rootMargin: '200px' },
      );
      observer.observe(root);
      document.addEventListener(
        'astro:before-swap',
        () => observer.disconnect(),
        { once: true },
      );
    }
  }
  initialise();
  document.addEventListener('astro:page-load', initialise);
</script>
<style>
  @reference "@styles/theme.css";

  .github-contributions {
    @apply font-jetbrainsmono text-sm lg:text-base;

    --github-activity-0: var(--color-grey-200);
    --github-activity-1: var(--color-primary-200);
    --github-activity-2: var(--color-primary-400);
    --github-activity-3: var(--color-primary-600);
    --github-activity-4: var(--color-primary-800);
  }
  :global(:where([data-theme="dark"])) .github-contributions {
    --github-activity-0: var(--color-grey-800);
  }
  .github-contributions [data-summary],
  .github-contributions :global(.github-contributions__month) {
    @apply text-gray-600 dark:text-gray-400;
  }

  .github-contributions :global(.github-contributions__grid) {
    display: grid;
    grid-template-columns: repeat(var(--weeks), minmax(0.75rem, 1fr));
    grid-template-rows: auto repeat(7, 0.75rem);
    gap: 0.25rem;
    min-width: max-content;
    padding-inline: 0.5rem;
  }
  .github-contributions :global(.github-contributions__month) {
    font-size: 0.75rem;
  }
  .github-contributions :global(.github-contributions__day) {
    min-width: 0.75rem;
    padding: 0;
    border: 0;
    border-radius: 2px;
    background: var(--github-activity-0);
  }
  .github-contributions :global([data-level="1"]) {
    background: var(--github-activity-1);
  }
  .github-contributions :global([data-level="2"]) {
    background: var(--github-activity-2);
  }
  .github-contributions :global([data-level="3"]) {
    background: var(--github-activity-3);
  }
  .github-contributions :global([data-level="4"]) {
    background: var(--github-activity-4);
  }
</style>
