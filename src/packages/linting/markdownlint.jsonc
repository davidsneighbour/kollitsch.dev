{
  "devDependencies": {
    "@github/markdownlint-github": "0.8.5",
    "@dnbhq/markdownlint-config": "2.0.0",
    "markdownlint": "0.42.1",
    "markdownlint-cli2": "0.24.1",
    "markdownlint-rule-extended-ascii": "0.2.1",
    "markdownlint-rule-list-duplicates": "0.0.1",
    "markdownlint-rule-relative-links": "5.1.4",
    "markdownlint-rule-search-replace": "1.2.0",
    "markdownlint-rule-title-case-style": "0.4.3"
  },
  "scripts": {
    "lint:markdown": "markdownlint-cli2 --config src/config/.markdownlint.jsonc src/content/blog/**/*.{md,mdx}",
    "lint:markdown:fix": "markdownlint-cli2 --config src/config/.markdownlint.jsonc --fix src/content/blog/**/*.{md,mdx}"
  },
  "overrides": {
    "markdownlint-cli2": {
      "js-yaml": "5.5.0"
    },
    "markdownlint-rule-title-case-style": {
      "markdownlint": {
        "markdown-it": "15.0.3"
      }
    },
    "smol-toml": "1.9.1"
  }
}
