---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '@utils/content.ts';

export interface Props {
  post: CollectionEntry<'blog'>;
}

const { post }: Props = Astro.props;
const origin = post.data.origin;
---

{origin?.type === 'mastodon' && (
    <p class="text-sm text-gray-500 dark:text-gray-400">
      Originally posted in the
      <a
        href="/stream/"
        class="underline"
      >stream</a> on {formatDate(new Date(origin.published))}. See the
      <a
        href={origin.url}
        target="_blank"
        rel="noopener noreferrer"
        class="underline"
      >original Mastodon post</a>.
    </p>
  )}
