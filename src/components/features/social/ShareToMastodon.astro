---
import type { CollectionEntry } from "astro:content";

import ShareIntentLink from "@components/features/social/ShareIntentLink.astro";
import type { IconName } from "@utils/icon-names";

export interface Props {
  post: CollectionEntry<"blog">;
  class?: string;
}

const { post, class: className = "" }: Props = Astro.props;
const permalink = Astro.url.toString();
const mastodonIcon = "fa7-brands:mastodon" as IconName;
---

<ShareIntentLink
  icon={mastodonIcon}
  label="Share to Mastodon"
  urlTemplate="https://{instance}/share?text={text}&url={url}"
  title={post.data.title}
  description={post.data.description}
  permalink={permalink}
  instanceStorageKey="mastodon_instance_url"
  class={className}
/>
