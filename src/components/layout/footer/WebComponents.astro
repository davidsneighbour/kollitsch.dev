---
import { getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { wordmarkArtwork } from '@data/brand-artwork.ts';
import type { MarkdownInstance } from 'astro';

type BlogEntry =
  | CollectionEntry<'blog'>
  | (MarkdownInstance<Record<string, unknown>> & {
      data?: Record<string, unknown>;
    });

export interface Props {
  post?: BlogEntry;
}

const { post }: Props = Astro.props;

// read the components list from frontmatter in `options.head.components`
function extractComponentsFromPost(
  p: BlogEntry | undefined,
): string[] | undefined {
  const data = (p as { data?: unknown } | undefined)?.data;
  if (!data || typeof data !== 'object') return undefined;

  const options = (data as Record<string, unknown>)['options'];
  if (!options || typeof options !== 'object') return undefined;

  const head = (options as Record<string, unknown>)['head'];
  if (!head || typeof head !== 'object') return undefined;

  const comps = (head as Record<string, unknown>)['components'];
  if (!Array.isArray(comps)) return undefined;

  // ensure all entries are strings
  if (!comps.every((c) => typeof c === 'string')) return undefined;

  return comps as string[];
}

const components = extractComponentsFromPost(post);
const wordmarkImage = await getImage(wordmarkArtwork.image);
const wordmarkBackgroundImage = `url("${wordmarkImage.src}")`;
const wordmarkBackgroundPosition = wordmarkArtwork.position;
const wordmarkBackgroundSize = wordmarkArtwork.backgroundSize;
const wordmarkFallbackColor = wordmarkArtwork.inlineFill.fallbackColor;
const wordmarkFallbackColorDark = wordmarkArtwork.inlineFill.fallbackColorDark;
const wordmarkTintColor = wordmarkArtwork.inlineFill.tintColor;
const wordmarkTintColorDark = wordmarkArtwork.inlineFill.tintColorDark;
const wordmarkTintOpacity = String(wordmarkArtwork.inlineFill.tintOpacity);
const wordmarkTintOpacityDark = String(
  wordmarkArtwork.inlineFill.tintOpacityDark,
);
const wordmarkVariableCss = `
  :root {
    --wordmark-background-image: ${wordmarkBackgroundImage};
    --wordmark-background-position: ${wordmarkBackgroundPosition};
    --wordmark-background-size: ${wordmarkBackgroundSize};
    --wordmark-fallback-color: ${wordmarkFallbackColor};
    --wordmark-inline-fallback-color: ${wordmarkFallbackColor};
    --wordmark-inline-tint-color: ${wordmarkTintColor};
    --wordmark-inline-tint-opacity: ${wordmarkTintOpacity};
    --wordmark-tint-color: ${wordmarkTintColor};
    --wordmark-tint-opacity: ${wordmarkTintOpacity};
  }

  :root.dark {
    --wordmark-fallback-color: ${wordmarkFallbackColorDark};
    --wordmark-inline-fallback-color: ${wordmarkFallbackColorDark};
    --wordmark-inline-tint-color: ${wordmarkTintColorDark};
    --wordmark-inline-tint-opacity: ${wordmarkTintOpacityDark};
    --wordmark-tint-color: ${wordmarkTintColorDark};
    --wordmark-tint-opacity: ${wordmarkTintOpacityDark};
  }
`;

// lookup included components
const wants = new Set(components ?? []);

// maps component identifiers to their script source
const SCRIPTS: Record<string, string> = {
  'date-diff': '/vendor/datediff.js',
  'lite-youtube': '/vendor/lite-youtube-embed/lite-yt-embed.js',
};
---

<style
  is:global
  set:html={wordmarkVariableCss}
/>

{Object.entries(SCRIPTS).map(([name, src]) => wants.has(name) && <script src={src} async is:inline />)}

<script>
  import setup from '../../../data/setup.json';
  import { defineWordMark } from '../../../scripts/components/word-mark';

  defineWordMark({ text: setup.title });
</script>
