---
import type { HTMLAttributes, HTMLTag } from 'astro/types';
import { z } from 'zod';

const allowedTags = [
  'span',
  'div',
  'p',
  'strong',
  'em',
  'h1',
  'h2',
  'h3',
  'h4',
  'h5',
  'h6',
] as const satisfies readonly HTMLTag[];

const textImageFillSchema = z.object({
  as: z.enum(allowedTags).default('span'),
  backgroundAttachment: z.enum(['scroll', 'fixed', 'local']).default('scroll'),
  backgroundSize: z.string().min(1).default('cover'),
  classes: z.string().default(''),
  fallbackColor: z.string().min(1).default('currentColor'),
  imageUrl: z.string().min(1, 'imageUrl is required.'),
  position: z.string().min(1).default('center'),
  size: z.string().min(1).optional(),
  tintColor: z.string().min(1).optional(),
  tintColorDark: z.string().min(1).optional(),
  tintOpacity: z.number().min(0).max(1).default(0),
  tintOpacityDark: z.number().min(0).max(1).optional(),
});

type TextImageFillProps = z.input<typeof textImageFillSchema>;

export interface Props
  extends TextImageFillProps,
    Omit<HTMLAttributes<'span'>, keyof TextImageFillProps | 'class'> {
  class?: string;
}

const {
  as: asInput,
  backgroundAttachment: backgroundAttachmentInput,
  backgroundSize: backgroundSizeInput,
  classes: classesInput,
  class: className,
  fallbackColor: fallbackColorInput,
  imageUrl: imageUrlInput,
  position: positionInput,
  size: sizeInput,
  tintColor: tintColorInput,
  tintColorDark: tintColorDarkInput,
  tintOpacity: tintOpacityInput,
  tintOpacityDark: tintOpacityDarkInput,
  ...attrs
}: Props = Astro.props;

const parsed = textImageFillSchema.parse({
  as: asInput,
  backgroundAttachment: backgroundAttachmentInput,
  backgroundSize: backgroundSizeInput,
  classes: [classesInput, className].filter(Boolean).join(' '),
  fallbackColor: fallbackColorInput,
  imageUrl: imageUrlInput,
  position: positionInput,
  size: sizeInput,
  tintColor: tintColorInput,
  tintColorDark: tintColorDarkInput,
  tintOpacity: tintOpacityInput,
  tintOpacityDark: tintOpacityDarkInput,
});

const {
  as,
  imageUrl,
  size,
  position,
  backgroundSize,
  backgroundAttachment,
  classes,
  fallbackColor,
  tintColor,
  tintColorDark,
  tintOpacity,
  tintOpacityDark,
} = parsed;

const Tag: HTMLTag = as;

const styleParts: string[] = [
  `--text-fill-image: url("${imageUrl}")`,
  `--text-fill-position: ${position}`,
  `--text-fill-size: ${backgroundSize}`,
  `--text-fill-attachment: ${backgroundAttachment}`,
];

if (fallbackColorInput) {
  styleParts.push(`--text-fill-fallback: ${fallbackColor}`);
}

if (size) {
  styleParts.push(`--text-fill-font-size: ${size}`);
}

if (tintColor) {
  styleParts.push(`--text-fill-tint-color: ${tintColor}`);
}

if (tintColorDark) {
  styleParts.push(`--text-fill-tint-color-dark: ${tintColorDark}`);
}

if (tintOpacityInput !== undefined) {
  styleParts.push(`--text-fill-tint-opacity: ${String(tintOpacity)}`);
}

if (tintOpacityDark !== undefined) {
  styleParts.push(`--text-fill-tint-opacity-dark: ${String(tintOpacityDark)}`);
}

const style = styleParts.join('; ');
---

<Tag
  class={`text-image-fill inline-block ${size ? "text-(length:--text-fill-font-size)" : ""} ${classes}`}
  style={style}
  {...attrs}
>
  <slot />
</Tag>

<style>
  .text-image-fill {
    /* Indirected through --text-fill-active-tint-* so the dark-mode rule
     * below only needs to override two variables, not redeclare the whole
     * gradient - it falls back to the light tint when no dark variant was
     * passed in. */
    --text-fill-active-tint-color: var(--text-fill-tint-color, transparent);
    --text-fill-active-tint-opacity: var(--text-fill-tint-opacity, 0);

    color: var(--text-fill-fallback, currentColor);
    background-attachment: var(--text-fill-attachment, scroll);
    background-image:
      linear-gradient(
        rgb(
          from var(--text-fill-active-tint-color) r g b /
          var(--text-fill-active-tint-opacity)
        ),
        rgb(
          from var(--text-fill-active-tint-color) r g b /
          var(--text-fill-active-tint-opacity)
        )
      ),
      var(--text-fill-image);
    background-position: var(--text-fill-position, center);
    background-repeat: no-repeat;
    background-size: var(--text-fill-size, cover);
    -webkit-background-clip: text;
    background-clip: text;
  }

  /* :global() on just the ancestor: [data-theme="dark"] lives on <html>,
   * outside this component, so Astro's scoping must not require its own
   * scope-id attribute there too - a plain :where([data-theme="dark"])
   * ancestor combinator gets that attribute added by Astro same as any
   * other selector segment, and then never matches anything. */
  /* stylelint-disable-next-line selector-pseudo-class-no-unknown */
  :global([data-theme="dark"]) .text-image-fill {
    --text-fill-active-tint-color: var(
      --text-fill-tint-color-dark,
      var(--text-fill-tint-color, transparent)
    );
    --text-fill-active-tint-opacity: var(
      --text-fill-tint-opacity-dark,
      var(--text-fill-tint-opacity, 0)
    );
  }

  @supports ((-webkit-background-clip: text) or (background-clip: text)) {
    .text-image-fill {
      color: var(--text-fill-active-color, transparent);
    }
  }
</style>
