{
  "version": "0.2",
  "language": "en-GB",
  "files": [
    "src/{*,.*}/**/*.{md,mdx}"
  ],
  "ignorePaths": [
    "node_modules",
    "dist",
    "build",
    ".git",
    "**/test/logs/**"
  ],
  "ignoreRegExpList": [
    "/^\\s*youtube:\\s*\\S+$/m",
    "/^\\s*imageid:\\s*\\S+$/m",
    "/^\\s*-?\\s*src:\\s*.+\\.(?:jpg|jpeg|png|webp|gif|svg)\"?\\s*$/m"
  ],
  "dictionaries": [
    "dnb",
    "repos"
  ],
  "dictionaryDefinitions": [
    {
      "name": "dnb",
      "path": "./dnb.dict.txt",
      "addWords": true
    },
    {
      "name": "repos",
      "path": "./dnb-repos.txt"
    }
  ]
}
