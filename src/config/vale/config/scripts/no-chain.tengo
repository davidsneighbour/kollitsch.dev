text := import("text")

matches := []
offset := 0

for line in text.split(scope, "\n") {
    lower := text.to_lower(line)
    count := len(text.split(lower, "no ")) - 1
    count += len(text.split(lower, "no-")) - 1

    if count >= 2 && text.index(lower, "no no no") == -1 && text.index(lower, "no, no") == -1 {
        matches = append(matches, {begin: offset, end: offset + len(line)})
    }

    offset += len(line) + 1
}
