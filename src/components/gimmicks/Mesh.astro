---
export interface DensitySettingProp {
  particles?: number;
  connectionRadius?: number;
}

export interface Props {
  colorVar?: string;
  nodeOpacity?: number;
  connectionOpacity?: number;
  particleRadiusMin?: number;
  particleRadiusMax?: number;
  movementSpeed?: number;
  pointerRadius?: number;
  pointerForce?: number;
  // Multiplier for how much brighter dots and connections get the closer
  // they are to the pointer - 0 disables the glow entirely. 1 means "at
  // the very centre, twice as bright as normal", tapering with the same
  // eased curve as the repulsion force down to normal at pointerRadius.
  pointerGlowStrength?: number;
  // Minimum gap kept between any two particles, and how hard they push
  // apart when closer than that. Always active (not just near the
  // pointer) - this is what stops particles left clustered together
  // after a pointer interaction from just sitting there, and what makes
  // the field settle back into an even, non-overlapping spread once the
  // pointer moves away.
  particleMinDistance?: number;
  particleSeparationForce?: number;
  scrollInfluence?: number;
  scrollDamping?: number;
  // Box height as a CSS clamp(heightMin, heightPreferred, heightMax).
  // heightPreferred is the value that actually drives the height on most
  // screens (a vh unit); heightMin/heightMax are the floor/ceiling that
  // stop it from getting absurdly short or tall on extreme viewports.
  heightMin?: string;
  heightPreferred?: string;
  heightMax?: string;
  // How long the whole box takes to fade in/out as the trigger crosses
  // the viewport, and the CSS timing-function shaping that fade. Any
  // valid CSS <easing-function> works, including a linear() curve for a
  // custom multi-phase shape (fast in, then linear-ish, then a long slow
  // settle) that a single cubic-bezier() can't really express.
  fadeDuration?: string;
  fadeEasing?: string;
  density?: {
    desktop?: DensitySettingProp;
    tablet?: DensitySettingProp;
    mobile?: DensitySettingProp;
  };
}

// Base tuning. All of this is overridable per-instance via props - see the
// <Mesh /> call site (currently src/layouts/Site.astro) for the
// single place that actually controls how the effect looks on the site.
const DEFAULT_DENSITY = {
  desktop: { connectionRadius: 135, particles: 110 },
  mobile: { connectionRadius: 95, particles: 40 },
  tablet: { connectionRadius: 115, particles: 70 },
};

const {
  colorVar = '--color-primary',
  nodeOpacity = 0.14,
  connectionOpacity = 0.05,
  particleRadiusMin = 1,
  particleRadiusMax = 2.2,
  movementSpeed = 0.08,
  pointerRadius = 200,
  pointerForce = 0.04,
  pointerGlowStrength = 1.2,
  particleMinDistance = 26,
  particleSeparationForce = 0.06,
  scrollInfluence = 0.002,
  scrollDamping = 0.04,
  heightMin = '280px',
  heightPreferred = '66vh',
  heightMax = '850px',
  fadeDuration = '900ms',
  fadeEasing = 'ease',
  density = {},
} = Astro.props;

const config = {
  colorVar,
  connectionOpacity,
  density: {
    desktop: { ...DEFAULT_DENSITY.desktop, ...density.desktop },
    mobile: { ...DEFAULT_DENSITY.mobile, ...density.mobile },
    tablet: { ...DEFAULT_DENSITY.tablet, ...density.tablet },
  },
  movementSpeed,
  nodeOpacity,
  particleMinDistance,
  particleRadiusMax,
  particleRadiusMin,
  particleSeparationForce,
  pointerForce,
  pointerGlowStrength,
  pointerRadius,
  scrollDamping,
  scrollInfluence,
};
---

<div
  class="mesh"
  data-mesh
  data-mesh-config={JSON.stringify(config)}
  style={`--mesh-height-min: ${heightMin}; --mesh-height-preferred: ${heightPreferred}; --mesh-height-max: ${heightMax}; --mesh-fade-duration: ${fadeDuration}; --mesh-fade-easing: ${fadeEasing};`}
  aria-hidden="true"
>
  <canvas class="mesh-canvas"></canvas>
</div>

<style>
  .mesh {
    /*
     * No z-index here, deliberately. This is the first child of <body>,
     * and <body> has its own explicit background-color (not "transparent",
     * so it isn't promoted to the page canvas). A negative z-index would
     * land this in the "negative z-index descendants" paint step, which
     * runs BEFORE <body>'s own background paint step - hiding it behind
     * that background entirely. Leaving z-index at its default (auto)
     * keeps this in document order: painted after body's background,
     * before every later sibling (header/main/footer), which is what
     * "behind content, above the page background" actually requires.
     */
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    height: clamp(
      var(--mesh-height-min),
      var(--mesh-height-preferred),
      var(--mesh-height-max)
    );
    opacity: 0%;
    pointer-events: none;
    transition: opacity var(--mesh-fade-duration) var(--mesh-fade-easing);
    will-change: opacity;
  }

  .mesh.is-visible {
    opacity: 100%;
  }

  .mesh-canvas {
    /*
     * No mask here, deliberately. A canvas element already hard-clips its
     * own drawing to its own box on every side - that alone gives the
     * contained-with-a-hard-top-edge look. A mask that fades toward
     * transparent near the top would soften that edge instead of just
     * cutting it off.
     */
    display: block;
    width: 100%;
    height: 100%;
  }

  @media (prefers-reduced-motion: reduce) {
    .mesh {
      transition-duration: 400ms;
    }
  }
</style>

<script>
  // Only the bootstrap runs on page load. It observes the activation
  // sentinel and loads the renderer chunk on the first crossing; see
  // mesh-bootstrap.ts and mesh-renderer.ts.
  import { startMeshLifecycle } from './mesh-bootstrap';

  startMeshLifecycle(() =>
    import('./mesh-renderer').then((module) => module.createMeshRenderer),
  );
</script>
