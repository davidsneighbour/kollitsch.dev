{
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "13.1.0",
    "@dnbhq/secretlint-config": "0.1.1",
    "secretlint": "13.1.0"
  },
  "notes": {
    "why": "This is a temporary solution to avoid using secretlint in the CI/CD pipeline. It is not recommended to use secretlint in the CI/CD pipeline because it can cause issues with the build process. Instead, it is recommended to use secretlint in the local development environment."
  },
  "scripts": {
    "lint:secretlint": "secretlint --secretlintrc node_modules/@dnbhq/secretlint-config/config/secretlintrc.json --secretlintignore src/config/secretlint/.secretlintignore"
  }
}
