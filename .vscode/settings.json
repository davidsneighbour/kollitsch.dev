{
  "[astro]": {
    "editor.defaultFormatter": "astro-build.astro-vscode"
  },
  "accessibility.openChatEditedFiles": true,
  "astro.content-intellisense": true,
  "astro.updateImportsOnFileMove.enabled": true,
  "biome.configurationPath": "biome.jsonc",
  "biome.requireConfiguration": true,
  "chat.instructionsFilesLocations": {
    "ai/instructions": true
  },
  "chat.tools.terminal.autoApprove": {
    "npx astro": true
  },
  "cSpell.words": [
    "wireit"
  ],
  "css.validate": false,
  "editor.codeActionsOnSave": {
    "source.fixAll.biome": "explicit",
    "source.fixAll.markdownlint": "always"
  },
  "editor.formatOnPaste": true,
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "modificationsIfAvailable",
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "files.associations": {
    "**/*.astro": "astro",
    "**/*.css": "tailwindcss"
  },
  "files.autoSave": "onFocusChange",
  "files.autoSaveDelay": 1000,
  "files.autoSaveWhenNoErrors": false,
  "indentRainbow.colorOnWhiteSpaceOnly": true,
  "indentRainbow.indicatorStyle": "light",
  "javascript.preferences.importModuleSpecifier": "non-relative",
  "less.validate": false,
  "markdown.extension.toc.levels": "2..6",
  "markdown.extension.toc.unorderedList.marker": "*",
  "markdownlint.configFile": "src/config/.markdownlint.jsonc",
  "peacock.color": "#00c950",
  "scss.validate": false,
  "search.exclude": {
    "scratch.md": true,
    "scratch/**": true
  },
  "stylelint.configFile": "./src/config/stylelint/index.js",
  "stylelint.enable": true,
  "stylelint.validate": [
    "css",
    "scss",
    "less",
    "astro"
  ],
  "svg.preview.background": "black",
  "tailwindCSS.classAttributes": [
    "class",
    "className",
    "ngClass",
    "class:list",
    "classes"
  ],
  "tailwindCSS.files.exclude": [
    "**/.git/**",
    "**/node_modules/**",
    "**/.hg/**",
    "**/.svn/**",
    "**/dist/**",
    "**/.wireit/**",
    "**/.astro/**"
  ],
  "terminal.integrated.tabs.title": "${sequence}",
  "better-todo-tree.general.automaticGitRefreshInterval": 300,
  "better-todo-tree.general.debug": true,
  "better-todo-tree.general.exportPath": "~/todo-tree-%Y%m%d-%H%M.txt",
  "better-todo-tree.general.showActivityBarBadge": false,
  "better-todo-tree.general.showIconsInsteadOfTagsInStatusBar": true,
  "better-todo-tree.general.statusBar": "total",
  "better-todo-tree.general.tags": [
    "BUG",
    "HACK",
    "FIXME",
    "TODO",
    "XXX",
    "[ ]",
    "[x]",
    "@todo"
  ],
  "better-todo-tree.highlights.useColourScheme": true,
  "better-todo-tree.tree.scanMode": "workspace only",
  "typescript.preferences.importModuleSpecifier": "non-relative",
  "vale.enableSpellcheck": true,
  "vale.valeCLI.config": "src/config/.vale.ini",
  "vale.valeCLI.installVale": true,
  "vale.valeCLI.minAlertLevel": "error",
  "vale.valeCLI.syncOnStartup": true,
  "workbench.colorCustomizations": {
    "activityBar.activeBackground": "#00fc64",
    "activityBar.activeBorder": "#15202b",
    "activityBar.background": "#00fc64",
    "activityBar.foreground": "#15202b",
    "activityBar.inactiveForeground": "#15202b99",
    "activityBarBadge.background": "#b280ff",
    "activityBarBadge.foreground": "#15202b",
    "activityBarTop.activeBackground": "#00fc64",
    "activityBarTop.activeBorder": "#15202b",
    "activityBarTop.background": "#00fc64",
    "activityBarTop.foreground": "#15202b",
    "activityBarTop.inactiveForeground": "#15202b99",
    "commandCenter.border": "#15202b99",
    "commandCenter.foreground": "#15202b",
    "commandCenter.background": "#00fc64",
    "commandCenter.activeBackground": "#00c950",
    "commandCenter.activeForeground": "#15202b",
    "sash.hoverBorder": "#00fc64",
    "statusBar.background": "#00c950",
    "statusBar.debuggingBackground": "#00c950",
    "statusBar.debuggingForeground": "#15202b",
    "statusBar.foreground": "#15202b",
    "statusBarItem.hoverBackground": "#00fc64",
    "statusBarItem.remoteBackground": "#8c40ff",
    "statusBarItem.remoteForeground": "#e7e7e7",
    "titleBar.activeBackground": "#00c950",
    "titleBar.activeForeground": "#15202b",
    "titleBar.inactiveBackground": "#00c95099",
    "titleBar.inactiveForeground": "#15202b99"
  },
  "typos.config": "src/config/typos.toml"
}
