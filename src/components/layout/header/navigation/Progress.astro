---
export interface Props {
  classes?: string;
}

const {
  classes = 'progress z-40 relative [--height:4px] lg:[--height:6px]',
}: Props = Astro.props;
---

<div
  class={classes}
  role="progressbar"
  aria-valuemin="0"
  aria-valuemax="100"
  aria-valuenow="0"
  aria-label="Reading progress"
  data-reading-progress
>
  <div class="progress-fill"></div>
</div>
<script is:inline>
  (() => {
    window.kdev ??= {};

    if (window.kdev.readingProgressInitialised) {
      return;
    }

    window.kdev.readingProgressInitialised = true;

    const getScroll = () => {
      const d = document.documentElement;
      const b = document.body;
      const top = d.scrollTop || b.scrollTop;
      const height = (d.scrollHeight || b.scrollHeight) - d.clientHeight;
      return height > 0 ? (top / height) * 100 : 0;
    };

    let progressBars = document.querySelectorAll('[data-reading-progress]');

    const refreshProgressBars = () => {
      progressBars = document.querySelectorAll('[data-reading-progress]');
    };

    const updateProgress = () => {
      const scroll = getScroll();

      for (const progress of progressBars) {
        if (!(progress instanceof HTMLElement)) {
          continue;
        }

        const fill = progress.querySelector('.progress-fill');

        progress.setAttribute('aria-valuenow', String(Math.round(scroll)));
        progress.style.setProperty('--scroll', String(scroll / 100));
        progress.toggleAttribute('data-complete', scroll >= 99.9);

        if (fill instanceof HTMLElement) {
          fill.style.transform = `scaleX(${scroll / 100})`;
        }
      }
    };

    let ticking = false;

    const onScroll = () => {
      if (ticking) {
        return;
      }

      ticking = true;
      window.requestAnimationFrame(() => {
        updateProgress();
        ticking = false;
      });
    };

    document.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('load', updateProgress);
    document.addEventListener('astro:page-load', () => {
      refreshProgressBars();
      updateProgress();
    });

    updateProgress();
  })();
</script>

<style>
  @reference "@styles/theme.css";

  /*
   * A striped shimmer used to run here via an animated `background-position`,
   * then via a transform-animated overlay layer - at this bar's thickness
   * (4-6px) neither read as a visible "rolling" effect, so the shimmer was
   * dropped rather than kept for a look nobody could actually see. Only the
   * scroll-driven width fill remains.
   */
  .progress {
    --progress-height: var(--thickness, var(--height, 4px));
    --progress-bar-transition: transform 0.6s cubic-bezier(0.23, 1, 0.32, 1);
    --scroll: 0;

    @apply w-full overflow-hidden rounded-none bg-black/10;
    @apply shadow-[inset_0_1px_2px_rgba(0,0,0,0.075)];

    height: var(--progress-height);
  }

  .progress-fill {
    @apply absolute inset-y-0 left-0 h-full w-full origin-left rounded-full bg-brand-main-accent;

    transform: scaleX(0);
    transition: var(--progress-bar-transition);
  }

  @media (prefers-reduced-motion: reduce) {
    .progress-fill {
      @apply transition-none;
    }
  }

  .progress:not([data-complete]) .progress-fill {
    /*
     * The leading corner's radius is set on the box before `transform:
     * scaleX()` runs, so a plain circular radius gets squashed horizontally
     * by the same factor as the fill's width - a near-flat oval at low
     * scroll percentages instead of a round cap. Scaling the horizontal
     * radius by 1/scroll cancels that squash out, so the rendered corner
     * stays a true circle (matching the vertical radius) at every width.
     */
    --cap-radius: calc(var(--progress-height) / 2);

    border-radius: 0
      calc(var(--cap-radius) / max(var(--scroll), 0.01))
      calc(var(--cap-radius) / max(var(--scroll), 0.01))
      0 / 0 var(--cap-radius) var(--cap-radius) 0;
    transition:
      var(--progress-bar-transition),
      border-radius 0.2s cubic-bezier(0.645, 0.045, 0.355, 1);
  }

  .progress[data-complete] .progress-fill {
    @apply rounded-none;

    transition:
      var(--progress-bar-transition),
      border-radius 0.2s cubic-bezier(0.645, 0.045, 0.355, 1);
  }
</style>
