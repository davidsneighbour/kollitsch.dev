---
import type { IconName } from '@utils/icon-names.ts';
import type { HTMLAttributes } from 'astro/types';
import { Icon } from 'astro-icon/components';
import {
  type BrokenLinkReason,
  getBrokenLinkReasonLabel,
  getBrokenLinkStatusText,
  resolveBrokenLinkReason,
} from '../../../scripts/components/broken-link.ts';

const reasonIcons = {
  'redirect-loop': 'lucide:refresh-cw',
  'server-error': 'lucide:server-crash',
  'temporarily-unavailable': 'lucide:clock-alert',
  timeout: 'lucide:timer-off',
  'tls-error': 'lucide:shield-alert',
  unknown: 'lucide:unlink',
} satisfies Record<BrokenLinkReason, IconName>;

export interface Props extends Omit<HTMLAttributes<'a'>, 'href'> {
  href: string;
  reason: BrokenLinkReason;
  checked?: string;
}

const {
  href,
  reason: rawReason,
  checked,
  class: className = '',
  title,
  ...attrs
}: Props = Astro.props;

const reason = resolveBrokenLinkReason(rawReason);
const reasonLabel = getBrokenLinkReasonLabel(reason);
const statusText = getBrokenLinkStatusText(reason, checked);
const linkTitle = title ?? statusText;
---

<span
  class:list={[
    'not-prose inline-flex items-baseline gap-1 align-baseline',
    className,
  ]}
  data-broken-link
  data-broken-link-href={href}
  data-broken-link-reason={reason}
  data-broken-link-status="currently-unavailable"
  data-broken-link-checked={checked}
  data-broken-link-valid-reason={String(reason === rawReason)}
  title={statusText}
>
  <a
    {...attrs}
    href={href}
    title={linkTitle}
  >
    <slot />
  </a>
  <span
    class="inline-flex size-[1.15em] items-center justify-center text-amber-700 align-[-0.15em] dark:text-amber-400"
    role="img"
    aria-label={statusText}
  >
    <Icon
      name={reasonIcons[reason]}
      class="size-[0.95em]"
      aria-hidden="true"
    />
  </span>
  <span class="sr-only"> Current status: {reasonLabel}.</span>
</span>
