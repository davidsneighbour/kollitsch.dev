---
import type { IconName } from '@utils/icon-names.ts';
import type { HTMLAttributes } from 'astro/types';
import { Icon } from 'astro-icon/components';
import {
  type BrokenLinkReason,
  getBrokenLinkReasonLabel,
  getBrokenLinkStatusText,
  resolveBrokenLinkReason,
} from '../../../scripts/components/broken-link.ts';

const reasonIcons = {
  'redirect-loop': 'lucide:refresh-cw',
  'server-error': 'lucide:server-crash',
  'temporarily-unavailable': 'lucide:clock-alert',
  timeout: 'lucide:timer-off',
  'tls-error': 'lucide:shield-alert',
  unknown: 'lucide:unlink',
} satisfies Record<BrokenLinkReason, IconName>;

export interface Props extends Omit<HTMLAttributes<'a'>, 'href'> {
  href: string;
  reason: BrokenLinkReason;
  checked?: string;
}

const {
  href,
  reason: rawReason,
  checked,
  class: className = '',
  title,
  ...attrs
}: Props = Astro.props;

const reason = resolveBrokenLinkReason(rawReason);
const reasonLabel = getBrokenLinkReasonLabel(reason);
const statusText = getBrokenLinkStatusText(reason, checked);
const linkTitle = title ?? statusText;
---

<span
  class:list={[
    'not-prose inline-flex items-baseline gap-1 align-baseline',
    className,
  ]}
  data-broken-link
  data-broken-link-href={href}
  data-broken-link-reason={reason}
  data-broken-link-status="currently-unavailable"
  data-broken-link-checked={checked}
  data-broken-link-valid-reason={String(reason === rawReason)}
>
  <a
    {...attrs}
    href={href}
    title={linkTitle}
  >
    <slot />
  </a>
  <span
    class="group relative inline-flex align-[-0.15em] outline-none"
    tabindex="0"
    role="img"
    aria-label={statusText}
  >
    <span
      class="inline-flex size-[1.15em] items-center justify-center text-amber-700 dark:text-amber-400"
      aria-hidden="true"
    >
      <Icon
        name={reasonIcons[reason]}
        class="size-[0.95em]"
        aria-hidden="true"
      />
    </span>
    <span
      class="pointer-events-none absolute bottom-[calc(100%+0.35em)] left-1/2 z-50 w-max max-w-64 -translate-x-1/2 translate-y-1 scale-95 rounded-sm bg-green-700 px-3 py-1.5 text-xs text-white opacity-0 shadow-md transition-[opacity,scale,translate] duration-150 ease-out after:absolute after:top-full after:left-1/2 after:size-2.5 after:-translate-x-1/2 after:-translate-y-1/2 after:rotate-45 after:rounded-xs after:bg-green-700 group-hover:translate-y-0 group-hover:scale-100 group-hover:opacity-100 group-focus-visible:translate-y-0 group-focus-visible:scale-100 group-focus-visible:opacity-100 dark:bg-green-500 dark:text-gray-950 dark:after:bg-green-500"
      role="tooltip"
      aria-hidden="true"
    >
      {statusText}
    </span>
  </span>
  <span class="sr-only"> Current status: {reasonLabel}.</span>
</span>
