{
  "$schema": "https://frontmatter.codes/frontmatter.schema.json",
  "frontMatter.content.publicFolder": {
    "path": "src/assets/images/",
    "relative": true
  },
  "frontMatter.framework.id": "astro",
  "frontMatter.preview.host": "http://localhost:4321",
  "frontMatter.taxonomy.slugTemplate": "{{title}}",
  "frontMatter.validation.enabled": false,
  "frontMatter.taxonomy.contentTypes": [
    {
      "name": "article",
      "pageBundle": true,
      "defaultFileName": "index",
      "fields": [
        {
          "title": "Title",
          "name": "title",
          "type": "string",
          "required": true
        },
        {
          "title": "Description",
          "name": "description",
          "type": "string",
          "required": true
        },
        {
          "title": "Publishing date",
          "name": "date",
          "type": "datetime",
          "isPublishDate": true,
          "required": true
        },
        {
          "title": "Cover",
          "name": "cover",
          "type": "fields",
          "fields": [
            {
              "title": "Source",
              "name": "src",
              "type": "image",
              "isPreviewImage": true
            },
            {
              "title": "Title",
              "name": "title",
              "type": "string"
            },
            {
              "title": "Alt text",
              "name": "alt",
              "type": "string"
            },
            {
              "title": "Type",
              "name": "type",
              "type": "choice",
              "choices": [
                "image",
                "video"
              ],
              "default": "image"
            },
            {
              "title": "Unsplash ID",
              "name": "unsplash",
              "type": "string"
            },
            {
              "title": "Format",
              "name": "format",
              "type": "fields",
              "fields": [
                {
                  "title": "Content type",
                  "name": "contenttype",
                  "type": "choice",
                  "choices": [
                    "jpg",
                    "png",
                    "gif",
                    "svg",
                    "webp"
                  ],
                  "default": "jpg"
                },
                {
                  "title": "Quality",
                  "name": "quality",
                  "type": "number",
                  "default": 75
                }
              ]
            }
          ]
        },
        {
          "title": "Subtitle",
          "name": "subtitle",
          "type": "string"
        },
        {
          "title": "Summary",
          "name": "summary",
          "type": "string"
        },
        {
          "title": "Link title",
          "name": "linktitle",
          "type": "string"
        },
        {
          "title": "Tags",
          "name": "tags",
          "type": "tags"
        },
        {
          "title": "Category",
          "name": "category",
          "type": "string"
        },
        {
          "title": "Featured",
          "name": "featured",
          "type": "boolean",
          "default": false
        },
        {
          "title": "Draft",
          "name": "draft",
          "type": "draft",
          "default": false
        },
        {
          "title": "Publisher",
          "name": "publisher",
          "type": "choice",
          "choices": [
            "rework",
            "validate"
          ]
        }
      ]
    }
  ]
}
