text := import("text")

matches := []
offset := 0

for line in text.split(scope, "\n") {
    lower := text.to_lower(line)
    sentences := text.split(lower, ".")

    if len(sentences) >= 2 {
        first := text.trim_space(sentences[0])
        second := text.trim_space(sentences[1])

        if text.has_prefix(first, "don't ") || text.has_prefix(first, "do not ") {
            words := text.split(first, " ")
            verb_index := 1

            if text.has_prefix(first, "do not ") {
                verb_index = 2
            }

            if len(words) > verb_index {
                verb := words[verb_index]

                if text.has_prefix(second, verb + " ") {
                    matches = append(matches, {begin: offset, end: offset + len(line)})
                }
            }
        }
    }

    offset += len(line) + 1
}
