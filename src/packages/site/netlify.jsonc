{
  "devDependencies": {
    "@netlify/functions": "5.3.0"
  },
  "scripts": {
    "clean:netlify": "wireit",
    "deploy": "wireit",
    "deploy:build": "wireit",
    "deploy:release": "wireit"
  },
  "wireit": {
    "clean:netlify": {
      "command": "find .netlify -type f ! -name \".gitignore\" -delete"
    },
    "deploy": {
      "command": "netlify deploy --prod --open",
      "dependencies": [
        "deploy:build"
      ]
    },
    "deploy:build": {
      "command": "npm run build",
      "dependencies": [
        "deploy:release"
      ]
    },
    "deploy:release": {
      "command": "npm run release",
      "dependencies": [
        "check"
      ]
    }
  }
}
