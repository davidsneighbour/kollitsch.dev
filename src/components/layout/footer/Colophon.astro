---
import setup from "@data/setup.json" with { type: "json" };

const adjust = 1.9;
const titleFontSize = Math.floor((100 / setup.title.length) * adjust);
export interface Props {}
---

<div
  class="isolate mt-64 -mb-16 overflow-hidden
    font-changa text-center leading-none
    whitespace-nowrap select-none"
  aria-hidden="true"
  data-dnb-design-exception="decorative-low-contrast"
>
  <span
    class="d-inline-block
    transition duration-2000 ease-in-out
    text-olive-100 hover:text-olive-200
    dark:text-olive-900 dark:hover:text-olive-800"
    style={`font-size: ${titleFontSize}vw;`}
  >
    {setup.title}
  </span>
</div>
