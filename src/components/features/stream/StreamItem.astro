---
import IconLink from '@components/shared/links/IconLink.astro';
import { formatDate } from '@utils/content.ts';
import type { StreamStatus } from '@utils/stream-shared.ts';
import { Icon } from 'astro-icon/components';

export interface Props {
  status: StreamStatus;
  /** True for a self-reply rendered nested inside its thread's root card. */
  nested?: boolean;
}

const { status, nested = false }: Props = Astro.props;
const date = new Date(status.createdAt);
const hasSpoiler = status.spoilerText.trim().length > 0;
const media = status.media.filter((item) => item.url != null);
---

<article
  class:list={[
    'flex flex-col gap-2 text-sm',
    nested
      ? 'border-l border-gray-900/10 py-2 pl-4 dark:border-gray-100/10'
      : 'rounded-lg bg-white/5 px-4 py-3 outline outline-gray-900/10 -outline-offset-1 transition-colors hover:bg-white/10 dark:bg-black/20 dark:outline-white/10 dark:hover:bg-black/30',
  ]}
  data-stream-status-id={status.id}
>
  <div class="flex items-center gap-2 text-xs text-gray-500 dark:text-gray-400">
    <Icon
      name="broadcast"
      class="size-3.5"
    />
    <time datetime={status.createdAt}>{formatDate(date)}</time>
  </div>

  {hasSpoiler ? (
      <details>
        <summary class="cursor-pointer">{status.spoilerText}</summary>
        <div class="mt-2" set:html={status.contentHtml} />
      </details>
    ) : (
      <div set:html={status.contentHtml} />
    )}

  {media.length > 0 && (
      status.sensitive ? (
        <details>
          <summary class="cursor-pointer text-xs">Show sensitive media</summary>
          <div class="mt-2 flex flex-wrap gap-2">
            {media.map((item) => (
              <img
                src={item.previewUrl ?? item.url ?? ''}
                alt={item.description ?? 'No alt text provided'}
                class="h-24 w-24 rounded-md object-cover"
                loading="lazy"
              />
            ))}
          </div>
        </details>
      ) : (
        <div class="flex flex-wrap gap-2">
          {media.map((item) => (
            <img
              src={item.previewUrl ?? item.url ?? ''}
              alt={item.description ?? 'No alt text provided'}
              class="h-24 w-24 rounded-md object-cover"
              loading="lazy"
            />
          ))}
        </div>
      )
    )}

  <div
    class="flex flex-wrap items-center gap-3 text-xs text-gray-500 dark:text-gray-400"
  >
    <span>{status.counts.replies} replies</span>
    <span>{status.counts.favourites} favourites</span>
    <span>{status.counts.boosts} boosts</span>
    {status.url && (
        <IconLink
          href={status.url}
          icon="chat-left-text"
          linkClass="ml-auto"
          target="_blank"
          rel="noopener noreferrer"
        >
          Discuss on Mastodon
        </IconLink>
      )}
  </div>
</article>
