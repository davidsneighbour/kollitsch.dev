{
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "@vitest/browser-playwright": "^4",
    "@vitest/coverage-v8": "^4",
    "@vitest/ui": "^4",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "cheerio": "1.2.0",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "^4"
  },
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npx playwright test --tsconfig ./tsconfig.playwright.json",
    "test:e2e:ui": "npx playwright test --ui --tsconfig ./tsconfig.playwright.json",
    "test:live": "npx playwright test --config ./playwright.live.config.ts --tsconfig ./tsconfig.playwright.json",
    "test:postinstall": "npx playwright install",
    "test:ui": "vitest --ui"
  },
  "wireit": {}
}
