---
/**
 * Resolves the pre-generated social/OG image for a piece of content and
 * emits meta tags (or URL/path/tag).
 *
 * Images are generated ahead of time by `npm run build:ogimages` (see
 * src/scripts/build/build-og-images.ts and
 * scratch/og-image-generation.plan.md) and committed under
 * `public/images/social/`. This component performs no rendering: it only
 * resolves the static file path and falls back to the site default when a
 * post-specific image hasn't been generated yet (a normal state on a
 * branch where lint-staged hasn't run, or before the first
 * `build:ogimages` run after adding this post).
 */

import fs from 'node:fs';
import path from 'node:path';
import type { OpenGraphPayload } from '@utils/content.ts';
import { createLogger, type Logger } from '@utils/logger.ts';
import {
  getBlogSocialImagePath,
  getDefaultSocialImagePath,
  SOCIAL_IMAGE_HEIGHT,
  SOCIAL_IMAGE_WIDTH,
} from '@utils/social-image/paths.ts';

const log: Logger = createLogger({ slug: 'OpenGraphImage' });

export interface Props {
  openGraph: OpenGraphPayload;
  /** Alt text for the image (default: openGraph.title) */
  alt?: string;
  /**
   * What to return:
   * - 'og':      full set of OG <meta> tags (default)
   * - 'twitter': Twitter <meta> tags
   * - 'path':    web path from site root (/images/social/blog/2026/slug.jpg)
   * - 'url':     absolute URL
   * - 'tag':     <img> tag
   */
  return?: 'og' | 'path' | 'tag' | 'twitter' | 'url';
}

const {
  openGraph,
  return: returnType = 'og',
  alt = openGraph.title,
} = Astro.props as Props;

const image = openGraph.image;
const hasContentIdentity = typeof image?.id === 'string' && image.id.length > 0;

function existsInPublic(webPath: string): boolean {
  return fs.existsSync(path.join(process.cwd(), 'public', webPath));
}

const defaultPath = getDefaultSocialImagePath();
const candidatePath = hasContentIdentity
  ? getBlogSocialImagePath(image!.id!)
  : undefined;

let resolvedPath = defaultPath;
if (candidatePath && existsInPublic(candidatePath)) {
  resolvedPath = candidatePath;
} else if (candidatePath && import.meta.env.DEV) {
  log.warn(
    `Missing generated social image for blog:${image?.id}. Using ${defaultPath}. Run npm run build:ogimages.`,
  );
}

const mime = 'image/jpeg';
---

<>
  {(() => {
  const altText = alt ?? (openGraph.title || 'unknown');
  const canonicalBase =
    typeof openGraph.url === 'string' && openGraph.url.length > 0
      ? openGraph.url
      : Astro.url;
  const abs = new URL(resolvedPath, canonicalBase).toString();

  return (
    <>
      {returnType === 'path' && resolvedPath}

      {returnType === 'url' && abs}

      {returnType === 'tag' && (
        <img
          src={resolvedPath}
          alt={altText}
          width={SOCIAL_IMAGE_WIDTH}
          height={SOCIAL_IMAGE_HEIGHT}
        />
      )}

      {returnType === 'twitter' && (
        <>
          <meta name="twitter:image" content={abs} />
          <meta name="twitter:image:alt" content={altText} />
        </>
      )}

      {(returnType === 'og' ||
        !['path', 'url', 'tag', 'twitter'].includes(returnType)) && (
        <>
          <meta property="og:image" content={abs} />
          <meta property="og:image:type" content={mime} />
          <meta
            property="og:image:width"
            content={SOCIAL_IMAGE_WIDTH.toString()}
          />
          <meta
            property="og:image:height"
            content={SOCIAL_IMAGE_HEIGHT.toString()}
          />
          <meta property="og:image:alt" content={altText} />
        </>
      )}
    </>
  );
})()}
</>
