---
import IconLink from '@components/shared/links/IconLink.astro';
import type { IconName } from '@utils/icon-names.ts';
import type { ShareValues, SocialShare } from '@utils/social.pure.ts';
import { buildShareUrl, normalizeShareInstance } from '@utils/social.pure.ts';
import type { HTMLAttributes } from 'astro/types';

export interface Props extends Omit<HTMLAttributes<'a'>, 'translate'> {
  translate?: 'yes' | 'no';
  share: SocialShare;
  values: ShareValues;
  icon?: IconName;
}

const { share, values, icon, class: className, ...attributes } = Astro.props;
const href = buildShareUrl(share.url, {
  ...values,
  ...(share.instance
    ? { instance: normalizeShareInstance(share.instance.default) }
    : {}),
});
const linkAttributes = {
  ...attributes,
  'data-share-instance': share.instance
    ? JSON.stringify(share.instance)
    : undefined,
  'data-share-intent': share.instance ? '' : undefined,
  'data-share-template': share.instance ? share.url : undefined,
  'data-share-values': share.instance ? JSON.stringify(values) : undefined,
  href,
  rel: 'noopener noreferrer',
  target: '_blank',
};
---

{icon ? (
  <IconLink {...linkAttributes} icon={icon} linkClass={String(className ?? '')}>
    <slot />
  </IconLink>
) : (
  <a {...linkAttributes} class={className}>
    <slot />
  </a>
)}

<script>
  // This small delegated listener is the only work done before activation.
  // No imports, storage reads, or observers run until a visitor clicks.
  document.addEventListener('click', async (event) => {
    const link =
      event.target instanceof Element
        ? event.target.closest<HTMLAnchorElement>('a[data-share-intent]')
        : null;
    if (!link || event.defaultPrevented || event.button !== 0) return;
    event.preventDefault();
    if (link.dataset['sharePending']) return;
    link.dataset['sharePending'] = 'true';
    try {
      const { shareToInstance } = await import('./ShareIntentClient.ts');
      shareToInstance(link);
    } catch {
      // Keep the normal share destination usable if the lazy module fails.
      window.location.assign(link.href);
    } finally {
      delete link.dataset['sharePending'];
    }
  });
</script>
