{
  "devDependencies": {
    "@playwright/mcp": "0.0.81",
    "chrome-devtools-mcp": "1.9.0",
    "mcp-remote": "0.14.2"
  },
  "scripts": {
    "audit:agent-ready": "node src/scripts/linting/agent-ready-audit.ts",
    "skills": "npx skills",
    "skills:add": "node src/scripts/maintenance/skills.ts add",
    "skills:install": "node src/scripts/maintenance/skills.ts install",
    "skills:links": "node src/scripts/maintenance/prepare-skill-symlinks.ts",
    "skills:list": "node src/scripts/maintenance/skills.ts list",
    "skills:sync": "node src/scripts/maintenance/skills.ts sync",
    "skills:update": "node src/scripts/maintenance/skills.ts update",
    "postinstall:skills": "npm run skills:links",
    "postinstall:ai": "node src/scripts/maintenance/check-ai-symlink.ts"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
