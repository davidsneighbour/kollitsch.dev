---
/**
 * Site footer, styled as a terminal window below a decorative "we have a
 * footer" sticker note. The window holds a terminal session: a
 * neofetch-style `whoami` block, the introduction as `cat about.md`, the
 * footer navigation as `ls ~/`, and ranked social profiles as
 * `ls ~/elsewhere`. One compact colophon strip follows the window, above
 * the decorative `Colophon` watermark.
 *
 * @see documentation/components/layout/footer/footer.md
 */
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import patrickkollitsch from '@assets/images/patrick-kollitsch.png';
import patrickEyesBase from '@assets/images/patrick-kollitsch-eyes-base.png';
import pupilLeft from '@assets/images/patrick-pupil-left.png';
import pupilRight from '@assets/images/patrick-pupil-right.png';
import PeoplePledgeBadge from '@components/features/badges/PeoplePledgeBadge.astro';
import GitHubContributions from '@components/gimmicks/GitHubContributions.astro';
import Colophon from '@components/layout/footer/Colophon.astro';
import Icon from '@components/shared/elements/Icon.astro';
import IconLink from '@components/shared/links/IconLink.astro';
import Link from '@components/shared/links/Link.astro';
import rawNavData from '@data/footernavigation.json' with { type: 'json' };
import setup from '@data/setup.json' with { type: 'json' };
import { social, socialNetworksFor } from '@data/social.ts';
import Wordmark from '@dnbhq/wordmark';
import { getHomepageUrl, getPostsSortedByDraft } from '@utils/content';
import { pickCredit } from '@utils/greeting.pure.ts';
import { renderIntroductionHtml } from '@utils/introduction.pure.ts';
import type { Navigation } from '@utils/navigation';
import { mergeRel, networkHoverColour } from '@utils/social.pure.ts';
import { getTags } from '@utils/tags.ts';
import {
  ageVersion,
  dayClock,
  formatDayCount,
  formatDayMilestone,
  nextDayMilestone,
  UPTIME_UNITS,
} from '@utils/uptime.pure.ts';

export interface Props {}

const footerYearId = 'footer-current-year';
const currentYear = new Date().getFullYear().toString();
const siteSince = 2021;
const navData = rawNavData as Navigation;
const introductionHtml = renderIntroductionHtml(setup.introduction);

// The server renders the first credit line, so every build is identical; the
// client script swaps in a random one from `setup.credits` on page load.
const credit = pickCredit(setup.credits, () => 0);

// Prompt shown before every command; the dashes underline it, neofetch style.
const promptUser = 'patrick@dnb';
const promptRule = '-'.repeat(promptUser.length);

const posts = getPostsSortedByDraft(await getCollection('blog'));
const postCount = posts.length;

// Patrick's own uptime: age as a kernel version, the boot time in the zone
// he was born in, and the day count with its next round thousand. These are
// correct at build time; the client script keeps them current.
const born = new Date(setup.author.born);
const builtAt = new Date();
const bornVersion = ageVersion(born, builtAt);
const bornLabel = new Intl.DateTimeFormat('en-GB', {
  dateStyle: 'long',
  timeStyle: 'short',
  timeZone: setup.author.bornTimezone,
})
  .format(born)
  .replace(' at ', ', ');
const bornZone =
  new Intl.DateTimeFormat('en-GB', {
    timeZone: setup.author.bornTimezone,
    timeZoneName: 'short',
  })
    .formatToParts(born)
    .find((part) => part.type === 'timeZoneName')?.value ?? '';
const bornClock = dayClock(born, builtAt);
const bornMilestone = formatDayMilestone(
  nextDayMilestone(born, builtAt),
  setup.timezone,
);

// The "online" counter starts at the first published post.
const firstPostDate = posts.reduce<Date | undefined>((earliest, post) => {
  const date = new Date(post.data.date);
  return !earliest || date < earliest ? date : earliest;
}, undefined);
const firstPostLabel = firstPostDate
  ? new Intl.DateTimeFormat('en-GB', {
      dateStyle: 'long',
      timeZone: setup.timezone,
    }).format(firstPostDate)
  : String(siteSince);
let tagCount = 0;
try {
  tagCount = (await getTags()).length;
} catch {
  // The tag count is a nice-to-have; the footer must still render.
}

// Networks that are also on /connect/ are the main profiles: show them with
// their handles. Every other footer network goes into one icon-only row.
const footerNetworks = socialNetworksFor('footer');
const featuredNetworks = footerNetworks.filter((n) => n.show.connect);
const moreNetworks = footerNetworks.filter((n) => !n.show.connect);

// Featured rows colour only their icon with the brand colour, on hover of
// the whole row, so the colour moves into custom properties on the link.
const networkColourStyle = (fill: string): string | undefined => {
  const colour = networkHoverColour(fill);
  return colour
    ? `--footer-network-colour: ${colour.light}; --footer-network-colour-dark: ${colour.dark};`
    : undefined;
};
---

<footer
  class="isolate z-0 w-full"
  aria-label="Footer"
  data-footer-terminal
  data-greetings={JSON.stringify(setup.greetings)}
>
  <div class={setup.classes.containers.wide}>
    <h2 class="sr-only">
      Footer section with navigation and social media links
    </h2>

    <p
      class="footer-mark"
      aria-hidden="true"
      data-footer-mark="shown"
      data-dnb-design-exception="decorative-low-contrast"
    >
      <span class="footer-mark-copy">
        {'Hey look, we have a footer!!!!111One'
          .split(' ')
          .map((word, index) => (
            <Fragment>
              <span class="footer-mark-word" style={`--word-index: ${index}`}>
                {word}
              </span>{' '}
            </Fragment>
          ))}
      </span>
      <span class="footer-mark-sparks">
        {Array.from({ length: 12 }, (_, index) => (
          <span
            style={`--spark-angle: ${index * 30}deg; --spark-index: ${index % 3}`}
          />
        ))}
      </span>
      <Icon
        name="lucide:corner-right-down"
        class="footer-mark-arrow"
      />
    </p>

    <div
      class="footer-window"
      data-footer-window
    >
      <div
        class="footer-terminal grid grid-cols-1 gap-x-16 gap-y-12 px-4 py-12 font-jetbrainsmono text-sm sm:px-6 lg:px-8 xl:grid-cols-12 lg:text-base"
      >
        <div class="flex flex-col gap-12 xl:col-span-7">
          <section aria-labelledby="footer-whoami">
            <h3
              id="footer-whoami"
              class="footer-prompt"
            >
              <span
                class="footer-prompt-user"
                aria-hidden="true"
                >{promptUser}:~$</span
              >
              whoami<span class="sr-only">: about Patrick Kollitsch</span>
            </h3>

            <div class="footer-fetch">
              <Link
                href="/connect/"
                class="footer-fetch-avatar"
                data-footer-eyes
              >
                <Image
                  src={patrickkollitsch}
                  alt="Patrick Kollitsch"
                  width={400}
                  height={400}
                  loading="lazy"
                  class="footer-fetch-avatar-image border border-gray-200 dark:border-gray-800"
                />
                <Image
                  src={patrickEyesBase}
                  width={400}
                  height={400}
                  alt=""
                  loading="lazy"
                  aria-hidden="true"
                  class="footer-eyes-base footer-fetch-avatar-image"
                />
                {[
                  { image: pupilLeft, x: 144 },
                  { image: pupilRight, x: 220 },
                ].map(({ image, x }) => (
                  <img
                    src={image.src}
                    width={16}
                    height={16}
                    alt=""
                    aria-hidden="true"
                    class="footer-eye-pupil"
                    data-footer-pupil
                    data-x={x}
                    data-y="154"
                    style={`left: ${x / 4}%; top: 38.5%;`}
                  />
                ))}
              </Link>
              <div class="min-w-0">
                <p class="footer-fetch-title">{promptUser}</p>
                <p
                  class="footer-fetch-rule"
                  aria-hidden="true"
                >
                  {promptRule}
                </p>
                <dl class="footer-fetch-facts">
                  <dt>name</dt>
                  <dd>{setup.author.name}</dd>
                  <dt>alias</dt>
                  <dd>
                    <a href="https://davidsneighbour.dev/">David's Neighbour</a>
                  </dd>
                  <dt>role</dt>
                  <dd>full-stack web developer, online business consultant</dd>
                  <dt>host</dt>
                  <dd>Koh Samui, Thailand</dd>
                  <dt>local</dt>
                  <dd class="flex flex-wrap gap-x-2">
                    <span
                      data-footer-clock
                      data-timezone={setup.timezone}
                    ></span>
                    <span class="footer-muted">{setup.timezone}</span>
                  </dd>
                  <dt>online</dt>
                  <dd>
                    <span data-uptime-since>since {firstPostLabel}</span>
                    {firstPostDate && (
                      <span
                        class="footer-uptime"
                        data-footer-uptime
                        data-start={firstPostDate.toISOString()}
                        aria-hidden="true"
                        hidden
                      >
                        {/* The ", " separator sits outside the no-wrap unit, so the line can break after each comma. */}
                        {UPTIME_UNITS.map((unit, index) => (
                          <Fragment>
                            <span class="footer-uptime-unit" data-unit={unit}>
                              <span data-uptime-value></span>{' '}
                              <span data-uptime-label>{unit}</span>
                              {index < UPTIME_UNITS.length - 1 && ','}
                            </span>
                            {index < UPTIME_UNITS.length - 1 && ' '}
                          </Fragment>
                        ))}
                      </span>
                    )}
                  </dd>
                  <dt>stack</dt>
                  <dd>
                    <a href="https://astro.build/">Astro</a>,
                    <a href="https://gohugo.io/">GoHugo</a>,
                    <a href="https://wordpress.org/">WordPress</a>
                  </dd>
                  <dt>garden</dt>
                  <dd>
                    <a href="/blog/">{postCount} posts</a>
                    {tagCount > 0 && (
                      <Fragment>
                        , <a href="/tags/">{tagCount} tags</a>
                      </Fragment>
                    )}
                  </dd>
                </dl>
              </div>
            </div>
          </section>

          <section aria-labelledby="footer-about">
            <h3
              id="footer-about"
              class="footer-prompt"
            >
              <span
                class="footer-prompt-user"
                aria-hidden="true"
                >{promptUser}:~$</span
              >
              cat about.md<span class="sr-only">: introduction</span>
            </h3>
            <div
              id="about-introduction"
              class="footer-intro"
              set:html={introductionHtml}
            />
          </section>
        </div>

        <div class="flex flex-col gap-12 xl:col-span-5">
          <section aria-labelledby="footer-uptime">
            <h3
              id="footer-uptime"
              class="footer-prompt"
            >
              <span
                class="footer-prompt-user"
                aria-hidden="true"
                >{promptUser}:~$</span
              >
              uname -r &amp;&amp; uptime<span class="sr-only"
                >: Patrick's age</span
              >
            </h3>
            <dl
              class="footer-fetch-facts"
              data-footer-age
              data-born={born.toISOString()}
              data-timezone={setup.timezone}
            >
              <dt>kernel</dt>
              <dd><span data-age-version>{bornVersion}</span>-samui</dd>
              <dt>boot</dt>
              <dd>
                <time datetime={setup.author.born}>{bornLabel} {bornZone}</time>
              </dd>
              <dt>uptime</dt>
              <dd>
                <span data-age-days>{formatDayCount(bornClock.days)} days</span>
                <span
                  class="footer-uptime"
                  data-age-counter
                  aria-hidden="true"
                  hidden
                >
                  {/* Same no-wrap units as the "online" counter; the line can break after the comma. */}
                  <span class="footer-uptime-unit"
                    ><span data-age-value="days"></span>
                    days,</span
                  >
                  <span class="footer-uptime-unit"
                    ><span data-age-value="time"></span></span
                  >
                </span>
                <span
                  class="footer-muted block"
                  data-age-milestone
                >
                  # {bornMilestone}
                </span>
              </dd>
            </dl>
          </section>

          <nav aria-labelledby="footer-ls">
            <h3
              id="footer-ls"
              class="footer-prompt"
            >
              <span
                class="footer-prompt-user"
                aria-hidden="true"
                >{promptUser}:~$</span
              >
              ls ~/<span class="sr-only">: site navigation</span>
            </h3>
            <ul class="flex flex-wrap gap-x-6 gap-y-2">
              {navData.map((value) => (
                <li>
                  <a href={value.link}>{value.label.toLowerCase()}/</a>
                </li>
              ))}
            </ul>
          </nav>

          <section aria-labelledby="footer-elsewhere">
            <h3
              id="footer-elsewhere"
              class="footer-prompt"
            >
              <span
                class="footer-prompt-user"
                aria-hidden="true"
                >{promptUser}:~$</span
              >
              ls ~/elsewhere<span class="sr-only">: social media profiles</span>
            </h3>
            <ul class="flex flex-col gap-2">
              {featuredNetworks.map((network) => (
                <li>
                  <IconLink
                    href={network.profile.url}
                    icon={network.icon}
                    target={social.defaults.target}
                    rel={mergeRel(social.defaults.rel, network.profile.rel)}
                    title={network.profile.title}
                    style={networkColourStyle(network.classes.fill)}
                    class="footer-network-glyph size-[1.1em] shrink-0"
                    linkClass="footer-network gap-3"
                  >
                    <span class="footer-network-name">{network.id}</span>
                    {network.profile.handle && (
                      <span class="footer-network-handle footer-muted">
                        {network.profile.handle}
                      </span>
                    )}
                  </IconLink>
                </li>
              ))}
            </ul>
            {moreNetworks.length > 0 && (
              <>
                <p class="footer-muted mt-6 mb-2">
                  # and {moreNetworks.length} more
                </p>
                {/* Paint server for the Instagram icon, used on hover through
                    `hover:fill-[url(#instagram-gradient)_#FF0069]` in setup.json.
                    It stays rendered at zero size, because some browsers drop
                    gradients inside `display: none`. */}
                <svg
                  class="absolute size-0 overflow-hidden"
                  aria-hidden="true"
                  focusable="false"
                >
                  <defs>
                    <radialGradient
                      id="instagram-gradient"
                      cx="30%"
                      cy="107%"
                      r="150%"
                    >
                      <stop offset="0%" stop-color="#fdf497" />
                      <stop offset="5%" stop-color="#fdf497" />
                      <stop offset="45%" stop-color="#fd5949" />
                      <stop offset="60%" stop-color="#d6249f" />
                      <stop offset="90%" stop-color="#285aeb" />
                    </radialGradient>
                  </defs>
                </svg>
                <ul class="footer-network-more -ml-2.5">
                  {moreNetworks.map((network) => (
                    <li>
                      <IconLink
                        href={network.profile.url}
                        icon={network.icon}
                        target={social.defaults.target}
                        rel={mergeRel(social.defaults.rel, network.profile.rel)}
                        title={network.profile.title}
                        aria-label={network.label}
                        class={`size-5 ${network.classes.fill}`}
                        linkClass="footer-network-icon size-10 justify-center rounded-md"
                      />
                    </li>
                  ))}
                </ul>
              </>
            )}
            <p
              class="footer-prompt mt-10"
              aria-hidden="true"
            >
              <span class="footer-prompt-user">{promptUser}:~$</span>
              <span class="footer-cursor"></span>
            </p>
          </section>
        </div>
        <GitHubContributions
          class="min-w-0 xl:col-span-12"
          heading="GitHub activity"
        >
          <h3
            slot="heading"
            class="footer-prompt"
          >
            <span
              class="footer-prompt-user"
              aria-hidden="true"
              >{promptUser}:~$</span
            >
            <span aria-hidden="true">gh api graphql</span>
            <span class="sr-only">GitHub activity</span>
          </h3>
        </GitHubContributions>
      </div>
    </div>
  </div>

  <div
    class="footer-strip flex flex-col gap-4 px-4 pt-6 pb-2 font-jetbrainsmono text-xs sm:px-6 lg:px-8 lg:text-sm"
  >
    <div
      class="flex flex-col gap-x-8 gap-y-2 md:flex-row md:items-baseline md:justify-between"
    >
      <p>
        <span class="text-[1.5em] leading-none align-middle">&copy;</span>
        {siteSince}&ndash;<span id={footerYearId}>{currentYear}</span>
        <a href={getHomepageUrl()}>{setup.title}</a
        ><span
          id="site-version"
          aria-live="polite"
          aria-atomic="true"
        ></span
        >. All rights reserved.
      </p>
      <p>
        <span
          data-credit-slot
          data-credits={JSON.stringify(setup.credits)}
          >{credit}</span
        >
        <Wordmark
          inline
          color="var(--footer-wordmark-color)"
        />
      </p>
    </div>

    <div
      class="flex flex-col gap-x-8 gap-y-3 md:flex-row md:flex-wrap md:items-center md:justify-between"
    >
      <ul class="flex flex-wrap items-center gap-x-5 gap-y-2">
        <li>
          <IconLink
            href="/privacy-policy/"
            icon="lucide:shield-check"
            class="size-[1.2em]"
          >
            privacy
          </IconLink>
        </li>
        <li>
          <IconLink
            href="/security-policy/"
            icon="lucide:fingerprint-pattern"
            class="size-[1.2em]"
          >
            security
          </IconLink>
        </li>
        <li class="flex items-center gap-2">
          <Icon
            name="lucide:rss"
            class="size-[1.2em]"
          />
          <Link href="/rss.xml">rss</Link>
          <Link href="/atom.xml">atom</Link>
          <Link href="/feed.json">json</Link>
        </li>
      </ul>

      <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
        <span id="webring-mention">
          A member of the <a href="https://static.quest">Static.Quest</a> web
          ring!
        </span>
        <span class="flex items-center gap-2">
          <IconLink
            href="https://static.quest/previous/?host=kollitsch.dev"
            icon="lucide:chevron-left"
            aria-label="Previous site in the Static.Quest web ring"
          />
          <a href="https://static.quest/members">members</a>
          <IconLink
            href="https://static.quest/next/?host=kollitsch.dev"
            icon="lucide:chevron-right"
            iconPosition="postfix"
            aria-label="Next site in the Static.Quest web ring"
          />
          <a href="https://static.quest/random">feeling lucky?</a>
        </span>
      </div>

      <Link
        href="https://people.pledge.party/"
        class="people-pledge-badge self-start md:self-center"
        aria-label="The People's Pledge"
      >
        <PeoplePledgeBadge
          width={40}
          height={40}
        />
      </Link>
    </div>
  </div>

  <script
    is:inline
    define:vars={{ footerYearId }}
    data-astro-rerun
  >
    document.getElementById(footerYearId).innerText = new Date().getFullYear();

    (async () => {
      try {
        const el = document.getElementById('site-version');
        if (!el) return;
        const resp = await fetch('/api/siteinfo.json');
        if (!resp.ok) return;
        const data = await resp.json();
        const version = data?.version ?? null;
        const releasePage = data?.releasePage ?? null;
        if (version && releasePage) {
          el.textContent = '';
          const separator = document.createTextNode(' ៚ ');
          const link = document.createElement('a');
          Object.assign(link, {
            href: releasePage,
            rel: 'noopener noreferrer',
            target: '_blank',
            textContent: `v${version}`,
          });
          el.appendChild(separator);
          el.appendChild(link);
        }
      } catch (err) {
        // silence failures; footer should not break if API is unavailable
      }
    })();
  </script>

  <script>
    import { initFooterEyes } from '@components/layout/footer/FooterEyes';

    let cleanupEyes = () => {
      /* No portrait has been initialised yet. */
    };
    document.addEventListener('astro:page-load', () => {
      cleanupEyes();
      cleanupEyes = initFooterEyes();
    });
    document.addEventListener('astro:before-swap', () => cleanupEyes());
  </script>

  <script>
    import { footerMarkInitialState } from '@utils/footer-mark.pure.ts';
    import {
      formatZoneTime,
      type Greetings,
      pickCredit,
      pickGreeting,
    } from '@utils/greeting.pure.ts';
    import {
      ageVersion,
      dayClock,
      formatDayClockTime,
      formatDayCount,
      formatDayMilestone,
      formatUptimeValue,
      nextDayMilestone,
      UPTIME_UNITS,
      uptimeParts,
      uptimeUnitLabel,
    } from '@utils/uptime.pure.ts';

    // footer-uptime-digit-transition token (DESIGN.md).
    const DIGIT_DURATION = 400;
    const DIGIT_EASING = 'cubic-bezier(0.19, 1, 0.22, 1)';

    let tickTimer: number | undefined;
    let uptimeObserver: IntersectionObserver | undefined;

    function createDigit(char: string): HTMLSpanElement {
      const digit = document.createElement('span');
      digit.textContent = char;
      return digit;
    }

    /**
     * Writes `text` into `target`, one clipped slot per character. When
     * `animate` is set, a changed digit rolls up and out while the new one
     * rolls in from below. A change in digit count rebuilds without motion.
     */
    function renderValue(
      target: HTMLElement,
      text: string,
      animate: boolean,
    ): void {
      const slots = Array.from(target.children) as HTMLElement[];
      if (slots.length !== text.length) {
        target.replaceChildren(
          ...Array.from(text, (char) => {
            const slot = document.createElement('span');
            slot.className = 'footer-uptime-digit';
            slot.append(createDigit(char));
            return slot;
          }),
        );
        return;
      }

      Array.from(text).forEach((char, index) => {
        const slot = slots[index];
        if (!slot) return;
        const current = slot.lastElementChild as HTMLElement | null;
        if (current?.textContent === char) return;
        const next = createDigit(char);
        if (!animate || !current) {
          slot.replaceChildren(next);
          return;
        }
        // Drop digits still leaving from an earlier change.
        for (const child of Array.from(slot.children)) {
          if (child !== current) child.remove();
        }
        slot.append(next);
        const timing = { duration: DIGIT_DURATION, easing: DIGIT_EASING };
        current
          .animate(
            [
              { filter: 'blur(0)', opacity: 1, transform: 'translateY(0)' },
              {
                filter: 'blur(2px)',
                opacity: 0,
                transform: 'translateY(-100%)',
              },
            ],
            timing,
          )
          .finished.then(
            () => current.remove(),
            () => current.remove(),
          );
        next.animate(
          [
            {
              filter: 'blur(2px)',
              opacity: 0,
              transform: 'translateY(100%)',
            },
            { filter: 'blur(0)', opacity: 1, transform: 'translateY(0)' },
          ],
          timing,
        );
      });
    }

    /**
     * Fill the greeting slot (visitor's local hour), and run the Koh Samui
     * clock and both uptime counters on one timer aligned to whole seconds.
     * Runs on every page load, including ClientRouter navigations, because
     * the footer is swapped with the rest of the page.
     */
    function initFooterTerminal(): void {
      window.clearTimeout(tickTimer);
      uptimeObserver?.disconnect();
      const footer = document.querySelector<HTMLElement>(
        '[data-footer-terminal]',
      );
      if (!footer) return;

      let greetings: Greetings = {};
      try {
        greetings = JSON.parse(footer.dataset['greetings'] ?? '{}');
      } catch {
        // keep the empty fallback
      }
      const greeting = pickGreeting(new Date().getHours(), greetings);
      for (const slot of footer.querySelectorAll('[data-greeting-slot]')) {
        slot.textContent = greeting;
      }

      // A random credit line per page load; the server text stays otherwise.
      const creditSlot =
        footer.querySelector<HTMLElement>('[data-credit-slot]');
      if (creditSlot) {
        let credits: unknown = [];
        try {
          credits = JSON.parse(creditSlot.dataset['credits'] ?? '[]');
        } catch {
          // keep the server-rendered credit line
        }
        const credit = Array.isArray(credits) ? pickCredit(credits) : '';
        if (credit) creditSlot.textContent = credit;
      }

      const clock = footer.querySelector<HTMLElement>('[data-footer-clock]');
      const timeZone = clock?.dataset['timezone'];

      // Counters roll their digits only while they are on screen.
      const visible = new Set<Element>();
      uptimeObserver = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) visible.add(entry.target);
          else visible.delete(entry.target);
        }
      });

      const uptime = footer.querySelector<HTMLElement>('[data-footer-uptime]');
      const start = new Date(uptime?.dataset['start'] ?? '');
      const hasUptime = !!uptime && !Number.isNaN(start.getTime());
      if (uptime && hasUptime) {
        uptime.hidden = false;
        // Screen readers keep the calm "since <date>" text instead of a
        // counter that changes every second.
        footer.querySelector('[data-uptime-since]')?.classList.add('sr-only');
        uptimeObserver.observe(uptime);
      }

      // Patrick's age: kernel version, day count, and the next round day.
      const age = footer.querySelector<HTMLElement>('[data-footer-age]');
      const born = new Date(age?.dataset['born'] ?? '');
      const ageZone = age?.dataset['timezone'];
      const ageCounter = age?.querySelector<HTMLElement>('[data-age-counter]');
      const hasAge = !!ageCounter && !Number.isNaN(born.getTime());
      if (age && ageCounter && hasAge) {
        ageCounter.hidden = false;
        // Screen readers keep the day count, set once per page load.
        const days = age.querySelector<HTMLElement>('[data-age-days]');
        if (days) {
          days.textContent = `${formatDayCount(dayClock(born, new Date()).days)} days`;
          days.classList.add('sr-only');
        }
        uptimeObserver.observe(ageCounter);
      }

      if (!(clock && timeZone) && !hasUptime && !hasAge) return;
      const reduceMotion = window.matchMedia(
        '(prefers-reduced-motion: reduce)',
      );

      const tickUptime = (now: Date, animate: boolean): void => {
        if (!uptime || !hasUptime) return;
        const parts = uptimeParts(start, now);
        for (const unit of UPTIME_UNITS) {
          const unitEl = uptime.querySelector<HTMLElement>(
            `[data-unit="${unit}"]`,
          );
          const valueEl = unitEl?.querySelector<HTMLElement>(
            '[data-uptime-value]',
          );
          const labelEl = unitEl?.querySelector<HTMLElement>(
            '[data-uptime-label]',
          );
          if (!valueEl || !labelEl) continue;
          renderValue(valueEl, formatUptimeValue(unit, parts[unit]), animate);
          const label = uptimeUnitLabel(unit, parts[unit]);
          if (labelEl.textContent !== label) labelEl.textContent = label;
        }
      };

      const setText = (el: Element | null | undefined, text: string): void => {
        if (el && el.textContent !== text) el.textContent = text;
      };

      const tickAge = (now: Date, animate: boolean): void => {
        if (!age || !ageCounter || !hasAge) return;
        const clockParts = dayClock(born, now);
        const days = ageCounter.querySelector<HTMLElement>(
          '[data-age-value="days"]',
        );
        const time = ageCounter.querySelector<HTMLElement>(
          '[data-age-value="time"]',
        );
        if (days) renderValue(days, formatDayCount(clockParts.days), animate);
        if (time) renderValue(time, formatDayClockTime(clockParts), animate);
        setText(age.querySelector('[data-age-version]'), ageVersion(born, now));
        if (ageZone) {
          setText(
            age.querySelector('[data-age-milestone]'),
            `# ${formatDayMilestone(nextDayMilestone(born, now), ageZone)}`,
          );
        }
      };

      // Animate only when a counter is on screen and motion is allowed;
      // otherwise the digits are swapped without animation.
      const tick = (motion: boolean): void => {
        const now = new Date();
        if (clock && timeZone) {
          const time = formatZoneTime(now, timeZone);
          if (clock.textContent !== time) clock.textContent = time;
        }
        tickUptime(now, motion && !!uptime && visible.has(uptime));
        tickAge(now, motion && !!ageCounter && visible.has(ageCounter));
      };

      const schedule = (): void => {
        tickTimer = window.setTimeout(
          () => {
            tick(!reduceMotion.matches);
            schedule();
          },
          1000 - (Date.now() % 1000),
        );
      };
      tick(false);
      schedule();
    }

    document.addEventListener('astro:page-load', initFooterTerminal);

    let markObserver: IntersectionObserver | undefined;

    /**
     * Replays the footer mark entrance after it leaves and returns to view.
     */
    function initFooterMark(): void {
      markObserver?.disconnect();
      markObserver = undefined;

      const mark = document.querySelector<HTMLElement>('[data-footer-mark]');
      if (!mark) return;
      const reduceMotion = window.matchMedia(
        '(prefers-reduced-motion: reduce)',
      );
      const canObserve = 'IntersectionObserver' in window;

      const state = footerMarkInitialState({
        canObserve,
        reduceMotion: reduceMotion.matches,
        targetTop: mark.getBoundingClientRect().top,
        viewportHeight: window.innerHeight,
      });
      mark.dataset['footerMark'] = state;
      if (!canObserve || reduceMotion.matches) return;
      let armed = state === 'pending';

      // Watching the note itself permits a return from either direction.
      markObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) {
              armed = true;
              delete mark.dataset['footerBurst'];
              mark.dataset['footerMark'] = 'pending';
            } else {
              if (armed && !reduceMotion.matches) {
                mark.dataset['footerBurst'] = 'true';
              }
              mark.dataset['footerMark'] = 'shown';
              armed = false;
            }
          }
        },
        { rootMargin: '0px 0px -15% 0px' },
      );
      markObserver.observe(mark);
    }

    document.addEventListener('astro:page-load', initFooterMark);
  </script>

  <style>
    @reference "@styles/theme.css";

    footer {
      --footer-wordmark-color: var(--color-primary-700);
      --footer-badge-color: var(--color-primary-700);
    }

    /* stylelint-disable-next-line selector-pseudo-class-no-unknown */
    :global(:where([data-theme="dark"])) footer {
      --footer-wordmark-color: var(--color-primary-600);
      --footer-badge-color: var(--color-primary-600);
    }

    /*
     * "Hey look, we have a footer" mark: a tilted sticker note in the
     * display face that points down at the footer window. It is decorative
     * and aria-hidden. Its resting state is visible, so it shows without
     * JavaScript; the client script sets data-footer-mark="pending" only
     * when the entrance can run.
     */
    .footer-mark {
      @apply relative mr-4 mb-6 ml-auto flex w-fit max-w-[80%] items-end gap-1 font-changa text-2xl leading-tight text-primary-700 sm:mr-12 sm:text-3xl lg:mr-24 lg:text-4xl dark:text-primary-500;

      margin-top: 5lh;
      transform: rotate(-3deg);
      transform-origin: right bottom;
    }

    .footer-mark-arrow {
      @apply size-[1.25em] shrink-0;

      translate: 0 0.5em;
    }

    .footer-mark-word {
      display: inline-block;
      transform-origin: center bottom;
    }

    .footer-mark-word:not(:last-child) {
      margin-inline-end: 0.2em;
    }

    .footer-mark-word:last-child {
      font-size: 1.25em;
    }

    .footer-mark-sparks {
      position: absolute;
      inset: 50% auto auto 50%;
      pointer-events: none;
    }

    .footer-mark-sparks > span {
      position: absolute;
      width: 0.125em;
      height: 0.5em;
      background: currentcolor;
      opacity: 0%;
      rotate: var(--spark-angle);
    }

    .footer-mark-sparks > span:nth-child(3n) {
      @apply text-gray-600 dark:text-gray-400;
    }

    /* Finite celebration, replayed on each scroll return. */
    @media (prefers-reduced-motion: no-preference) {
      .footer-mark {
        transition: opacity 200ms ease-out;
      }

      .footer-mark[data-footer-mark="pending"] {
        opacity: 0%;
      }

      .footer-mark[data-footer-burst="true"] .footer-mark-word {
        animation: footer-word-pop 900ms cubic-bezier(0.19, 1, 0.22, 1) both;
        animation-delay: calc(var(--word-index) * 60ms);
      }

      /* stylelint-disable-next-line selector-pseudo-class-no-unknown */
      .footer-mark[data-footer-burst="true"] :global(.footer-mark-arrow) {
        animation: footer-arrow-kick 900ms ease-out 240ms both;
      }

      .footer-mark[data-footer-burst="true"] .footer-mark-sparks > span {
        animation: footer-spark-burst 900ms ease-out both;
        animation-delay: calc(180ms + var(--spark-index) * 60ms);
      }
    }

    @keyframes footer-word-pop {
      0% {
        opacity: 0%;
        transform: translateY(1em) rotate(-14deg) scale(0.4);
      }

      35% {
        opacity: 100%;
        transform: translateY(-0.25em) rotate(7deg) scale(1.25);
      }

      60% {
        transform: translateY(0.08em) rotate(-4deg) scale(0.95);
      }

      100% {
        opacity: 100%;
        transform: none;
      }
    }

    @keyframes footer-arrow-kick {
      0%,
      100% {
        transform: none;
      }

      35% {
        transform: translateY(0.4em) rotate(-12deg) scale(1.3);
      }

      65% {
        transform: translateY(-0.15em) rotate(8deg);
      }
    }

    @keyframes footer-spark-burst {
      0% {
        opacity: 0%;
        transform: translateY(-0.5em) scaleY(0.4);
      }

      15% {
        opacity: 100%;
      }

      70% {
        opacity: 100%;
      }

      100% {
        opacity: 0%;
        transform: translateY(-3em) scaleY(0.2);
      }
    }

    /*
     * The footer is a separate terminal section with no background fill.
     * Light mode retains its subtle shadow; dark mode has no shadow.
     */
    .footer-window {
      @apply rounded-lg shadow-sm dark:shadow-none;
    }

    /* Secondary text: keys, handles, comments, the colophon strip. */
    .footer-muted,
    .footer-strip,
    .footer-fetch-facts dt,
    .footer-fetch-rule {
      @apply text-gray-600 dark:text-gray-400;
    }

    /*
     * Prompt lines. Headings are Changa One site-wide; here they read as
     * shell input instead. The site-wide animated rule still draws under
     * each prompt as the section divider.
     */
    .footer-prompt {
      @apply mb-5 font-jetbrainsmono text-sm font-normal lg:text-base;

      line-height: 1.6;
    }

    .footer-prompt-user {
      @apply text-gray-600 dark:text-gray-400;
    }

    /* neofetch: avatar as the logo, facts beside it. */
    .footer-fetch {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      gap: 1.5rem;
      align-items: start;
    }

    /*
     * The avatar's flat left side sits flush on the left edge of the footer
     * window. The breakout equals the window's horizontal padding (px-4,
     * sm:px-6, lg:px-8). The negative margin moves the box itself, so the
     * grid track shrinks with it and the facts table keeps its gap.
     */
    .footer-fetch-avatar {
      position: relative;
      --footer-avatar-size: 10rem;
      --footer-avatar-breakout: 1rem;

      display: block;
      width: var(--footer-avatar-size);
      height: var(--footer-avatar-size);
      margin-inline-start: calc(-1 * var(--footer-avatar-breakout));
    }

    .footer-fetch-avatar-image {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: 0 9999px 9999px 0;
    }

    .footer-eyes-base,
    .footer-eye-pupil {
      display: none;
      pointer-events: none;
      position: absolute;
    }
    .footer-eyes-base {
      inset: 0;
    }
    .footer-eye-pupil {
      width: 4%;
      height: 4%;
      transform: translate(-50%, -50%);
    }
    @media (prefers-reduced-motion: no-preference) {
      [data-eyes-active] .footer-eyes-base,
      [data-eyes-active] .footer-eye-pupil {
        display: block;
      }
    }

    .footer-fetch-title {
      @apply font-medium text-gray-800 dark:text-gray-100;
    }

    .footer-fetch-facts {
      display: grid;
      grid-template-columns: max-content minmax(0, 1fr);
      gap: 0.25rem 1.25rem;
      margin-top: 0.25rem;
    }

    /*
     * Uptime counter. Each unit stays on one line ("07 seconds" never
     * splits). Digit slots are created by the client script, so they are
     * reached through :global() under the scoped parent. Each slot stacks
     * the leaving and the arriving digit in one grid cell and clips them
     * with clip-path, which (unlike overflow: hidden) keeps the text
     * baseline.
     */
    .footer-uptime-unit {
      white-space: nowrap;
    }

    /* stylelint-disable-next-line selector-pseudo-class-no-unknown */
    .footer-uptime :global(.footer-uptime-digit) {
      display: inline-grid;
      clip-path: inset(0);
    }

    /* stylelint-disable-next-line selector-pseudo-class-no-unknown */
    .footer-uptime :global(.footer-uptime-digit > span) {
      grid-area: 1 / 1;
    }

    @media (min-width: 40rem) {
      .footer-fetch-avatar {
        --footer-avatar-size: 12rem;
        --footer-avatar-breakout: 1.5rem;
      }
    }

    @media (min-width: 64rem) {
      .footer-fetch-avatar {
        --footer-avatar-size: 15rem;
        --footer-avatar-breakout: 2rem;
      }
    }

    /* Below 30rem the facts table needs the full width: avatar on top. */
    @media (max-width: 29.99rem) {
      .footer-fetch {
        grid-template-columns: minmax(0, 1fr);
      }
    }

    /* The introduction stays in the reading face, not in mono. */
    .footer-intro {
      @apply max-w-[62ch] font-exo2 text-base font-light lg:text-lg;

      line-height: 1.65;
      text-wrap: pretty;
    }

    /* stylelint-disable-next-line selector-pseudo-class-no-unknown */
    .footer-intro :global(p + p) {
      margin-top: 1em;
    }

    /*
     * Hovering or focusing a featured row colours only its icon with the
     * network's brand colour (set as custom properties on the link); the
     * name and handle keep their link colours. The icon is rendered by a
     * child component, so it is reached with :global().
     */
    /* stylelint-disable-next-line selector-pseudo-class-no-unknown */
    .footer-network :global(.footer-network-glyph) {
      transition: color 150ms var(--ease-out-quad);
    }

    @media (hover: hover) {
      /* stylelint-disable-next-line selector-pseudo-class-no-unknown */
      .footer-network:hover :global(.footer-network-glyph) {
        color: var(--footer-network-colour, currentcolor);
      }

      /* stylelint-disable-next-line selector-pseudo-class-no-unknown */
      :global(:where([data-theme="dark"]))
        .footer-network:hover
        :global(.footer-network-glyph) {
        color: var(--footer-network-colour-dark, currentcolor);
      }
    }

    /* stylelint-disable-next-line selector-pseudo-class-no-unknown */
    .footer-network:focus-visible :global(.footer-network-glyph) {
      color: var(--footer-network-colour, currentcolor);
    }

    /* stylelint-disable-next-line selector-pseudo-class-no-unknown */
    :global(:where([data-theme="dark"]))
      .footer-network:focus-visible
      :global(.footer-network-glyph) {
      color: var(--footer-network-colour-dark, currentcolor);
    }

    .footer-network-name {
      min-width: 9ch;
    }

    .footer-network-handle {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      min-width: 0;
    }

    /*
     * The icon-only networks wrap like words in a balanced headline: each
     * item is an inline block, and `text-wrap: balance` evens out the line
     * lengths, so 13 icons split 7 + 6 instead of leaving one orphan icon
     * on its own line. Browsers without `balance` fall back to normal
     * wrapping.
     */
    .footer-network-more {
      text-wrap: balance;
    }

    .footer-network-more > li {
      display: inline-block;
      vertical-align: top;
    }

    .footer-network-icon {
      @apply text-gray-600 dark:text-gray-400;
    }

    /*
     * The one authored motion: a blinking bar cursor on the last prompt.
     * Sized to the JetBrains Mono ink box of the prompt (glyphs reach
     * 0.9375em above and 0.1875em below the baseline), then raised by
     * 0.0625em (1px at 16px) because it reads better optically.
     */
    .footer-cursor {
      display: inline-block;
      width: 0.3em;
      height: 1.125em;
      margin-left: 0.25em;
      vertical-align: -0.125em;

      @apply bg-primary-700 dark:bg-primary-500;
    }

    @media (prefers-reduced-motion: no-preference) {
      .footer-cursor {
        animation: footer-cursor-blink 1.1s steps(1, end) infinite;
      }
    }

    @keyframes footer-cursor-blink {
      50% {
        opacity: 0%;
      }
    }

    .people-pledge-badge {
      color: var(--footer-badge-color);
      transition: color 150ms ease;
    }

    .people-pledge-badge:hover {
      color: var(--color-primary-600);
    }

    /* stylelint-disable-next-line selector-pseudo-class-no-unknown */
    :global(:where([data-theme="dark"])) .people-pledge-badge:hover {
      color: var(--color-primary-400);
    }

    /*
     * The wordmark is an <a> from the @dnbhq/wordmark package, styled via its
     * `color` prop as a CSS variable reference (see the `footer` rule above),
     * so it can react to hover the same way the site's other nav links do
     * (NavItem.astro: primary-700/600 in light, primary-600/400 in dark)
     * instead of staying a flat, unhoverable brand color.
     */
    /* stylelint-disable-next-line selector-pseudo-class-no-unknown */
    :global(.dnb-wordmark) {
      transition: color 150ms ease;
    }

    /* stylelint-disable-next-line selector-pseudo-class-no-unknown */
    :global(.dnb-wordmark:hover) {
      --footer-wordmark-color: var(--color-primary-600);
    }

    /* stylelint-disable-next-line selector-pseudo-class-no-unknown */
    :global(:where([data-theme="dark"])) :global(.dnb-wordmark:hover) {
      --footer-wordmark-color: var(--color-primary-400);
    }

    /*
     * The site's global links rely on color alone at rest (underline only
     * appears on hover - see DESIGN.md's "Links (prose)" section), which is
     * fine against a page background but fails WCAG 1.4.1 (Use of Color) for
     * links embedded inside a sentence of body text: axe's link-in-text-block
     * rule flagged these against the surrounding text color at 2.89:1, just
     * under the 3:1 non-text-contrast threshold (#1835). Scoped underline
     * here, rather than changing the site-wide hover-only convention, since
     * these are the places links sit inline in running text.
     */
    /* stylelint-disable-next-line selector-pseudo-class-no-unknown */
    .footer-strip p :global(a),
    .footer-fetch-facts dd a,
    /* stylelint-disable-next-line selector-pseudo-class-no-unknown */
    #about-introduction :global(a),
    #webring-mention a {
      text-decoration-line: underline;
    }

    @media (prefers-reduced-motion: reduce) {
      /* stylelint-disable-next-line selector-pseudo-class-no-unknown */
      .footer-strip p :global(a) {
        transition: none;
      }
    }
  </style>
</footer>

