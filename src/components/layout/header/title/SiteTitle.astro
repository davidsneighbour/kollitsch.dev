---
import { getImage } from 'astro:assets';
import BrandLogo from '@components/ui/BrandLogo.astro';
import { wordmarkArtwork } from '@data/brand-artwork.ts';
import { getHomepageUrl } from '@utils/content.ts';

export interface Props {
  siteTitleId: string;
  // smaller masthead for reading pages (single posts), so the content
  // title starts above the fold
  compact?: boolean;
}

const homepageUrl = getHomepageUrl();
const { siteTitleId, compact = false }: Props = Astro.props;
// Full-res image, used only for the hover-reveal background (desktop-only,
// see the (hover: hover) and (pointer: fine) block below).
const headlineImage = await getImage(wordmarkArtwork.image);
---

<header
  aria-label="Site title"
  id={siteTitleId}
  class:list={[
    'site-title-hero w-full text-center',
    compact ? 'site-title-compact py-4 md:py-6' : 'py-6 md:py-10',
  ]}
  style={`--headline-bg: url("${headlineImage.src}");`}
>
  <a
    href={homepageUrl}
    class="site-title-link inline-block"
  >
    <BrandLogo class="site-title-logo" />
  </a>
</header>

<style>
  .site-title-hero {
    /* clip, not hidden: `hidden` establishes a scroll container, which would
       make animation-timeline: view() resolve against this element's own
       (static) scrollport instead of the page's. */
    overflow: clip;
    position: relative;
    animation: site-title-exit linear both;
    animation-timeline: view();
    animation-range: exit 0% exit 100%;
  }

  .site-title-link {
    position: relative;
    z-index: 1;
  }

  /*
   * Combination mark from src/brand/kollitsch-brand (see BrandLogo.astro).
   * Proportional scaling only: the height follows from the viewBox. The
   * logo itself carries no fill, blur, or per-glyph effects (brand guide,
   * section 12.2); its colours come from the --logo-* theme tokens.
   */
  /* stylelint-disable-next-line selector-pseudo-class-no-unknown */
  .site-title-link :global(.site-title-logo) {
    display: block;
    width: min(88vw, 64rem);
    height: auto;
  }

  /* stylelint-disable-next-line selector-pseudo-class-no-unknown */
  .site-title-compact .site-title-link :global(.site-title-logo) {
    width: min(72vw, 30rem);
  }

  /*
   * Hover animation: the header photo grows outward from the logo area
   * while the logo fades out, so the photo replaces it. The logo is never
   * recoloured or filled with the photo.
   *
   *   0–0.9s    ::after clip-path expands from the logo region to the header
   *   0.1–0.45s ::after opacity fades in
   *   0.35–0.85s logo link fades out
   *
   * On hover-out the link settles back first (0.6s); the ::after clip-path
   * takes longer to close (0.75s), so the photo keeps shrinking a beat
   * after the logo has returned.
   *
   * Gated on (hover: hover) and (pointer: fine) so touch devices are
   * unaffected.
   */
  @media (hover: hover) and (pointer: fine) {
    .site-title-hero::after {
      background-image: var(--headline-bg);
      background-position: center;
      background-repeat: no-repeat;
      background-size: 100vw auto;
      clip-path: inset(22% 8% round 48px);
      content: "";
      inset: 0;
      opacity: 0%;
      pointer-events: none;
      position: absolute;
      transition:
        clip-path 0.75s cubic-bezier(0.785, 0.135, 0.15, 0.86),
        opacity 0.5s cubic-bezier(0.19, 1, 0.22, 1);
      z-index: 0;
    }

    /*
     * The theme toggle sits in its own fixed corner overlay, outside this
     * header's DOM subtree, so plain `:hover` on an ancestor can't see it.
     * `.is-toggle-hover` (set by the toggle's own listeners, see Header.astro)
     * keeps the reveal alive while the pointer is over the toggle.
     */
    .site-title-hero:hover::after,
    .site-title-hero.is-toggle-hover::after {
      clip-path: inset(0% round 0);
      opacity: 100%;
      transition:
        clip-path 0.9s cubic-bezier(0.785, 0.135, 0.15, 0.86),
        opacity 0.35s cubic-bezier(0.19, 1, 0.22, 1) 0.1s;
    }

    .site-title-link {
      transition: opacity 0.6s cubic-bezier(0.19, 1, 0.22, 1);
    }

    .site-title-hero:hover .site-title-link,
    .site-title-hero.is-toggle-hover .site-title-link {
      opacity: 0%;
      transition: opacity 0.5s cubic-bezier(0.19, 1, 0.22, 1) 0.35s;
    }
  }

  @keyframes site-title-exit {
    from {
      opacity: 100%;
      transform: none;
    }

    to {
      opacity: 0%;
      transform: translateY(-12px) scale(0.98);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-title-hero {
      animation: none;
    }

    .site-title-hero::after {
      transition: opacity 0.3s ease;
    }

    .site-title-link {
      transition: opacity 0.4s ease;
    }
  }
</style>
