---
// @todo refactor and comment
import { join } from 'node:path';

export interface Props {
  readonly id?: string;
  readonly className?: string;
  readonly query?: string;
  readonly uiOptions?: Record<string, unknown>;
}

const { id, className, query, uiOptions = {} } = Astro.props;
const bundlePath = join(import.meta.env.BASE_URL, 'pagefind/');
---

<div
  id={id}
  class:list={[className, "pagefind-init"]}
  data-pagefind-ui
  data-bundle-path={bundlePath}
  data-query={query}
  data-ui-options={JSON.stringify(uiOptions)}
></div>
<script>
  import { PagefindUI } from '@pagefind/default-ui';

  function initPageFind() {
    const allSelector = '[data-pagefind-ui]';
    for (const el of document.querySelectorAll(
      `${allSelector}.pagefind-init`,
    )) {
      const elSelector = [
        ...(el.id ? [`#${el.id}`] : []),
        ...[...el.classList.values()].map((c) => `.${c}`),
        allSelector,
      ].join('');
      const bundlePath = el.getAttribute('data-bundle-path');
      const opts = JSON.parse(el.getAttribute('data-ui-options') ?? '{}');
      new PagefindUI({
        ...opts,
        bundlePath,
        element: elSelector,
      });
      el.classList.remove('pagefind-init');
      const query = el.getAttribute('data-query');
      if (query) {
        const input = el.querySelector<HTMLInputElement>(`input[type="text"]`);
        if (input) {
          input.value = query;
          input.dispatchEvent(new Event('input', { bubbles: true }));
        }
      }
    }
  }

  document.addEventListener('astro:page-load', initPageFind);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPageFind);
  } else {
    initPageFind();
  }
</script>
<style is:global>
  @reference "@styles/theme.css";

  /* stylelint-disable selector-class-pattern -- pagefind classes have underscores */
  @layer components {
    /*******************************************************************************
     * Container & core UI
     ******************************************************************************/
    .pagefind-ui {
      width: 100%;
    }

    .pagefind-ui__hidden {
      @apply hidden;
    }

    /*******************************************************************************
     * Search Form
     ******************************************************************************/
    .pagefind-ui__form {
      @apply relative;
    }

    .pagefind-ui__search-input {
      @apply col-start-1 row-start-1 mb-4 block h-8 w-full rounded-l-md bg-white px-3 py-1.5 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 focus:outline-2 focus:-outline-offset-2 focus:outline-primary-600 sm:pl-9 sm:text-sm/6 dark:bg-white/5 dark:text-white dark:outline-gray-700 dark:focus:outline-primary-500;
    }

    .pagefind-ui__search-clear {
      @apply absolute top-0 right-0 mb-4 h-8 w-40 bg-gray-300 dark:bg-gray-700;
    }

    /*****************************************************************************
     * Search Results
     *****************************************************************************/
    .pagefind-ui__drawer {
      @apply flex flex-row flex-wrap;
    }

    .pagefind-ui__results-area {
      flex: 1000;
    }

    .pagefind-ui__results {
      @apply ml-0 grid list-none grid-cols-3 gap-4 pl-0;
    }

    .pagefind-ui__result {
      @apply flex border-2 border-gray-500 p-4;

      align-items: flex-start;
    }

    .pagefind-ui__message {
      display: flex;
      align-items: center;
    }

    .pagefind-ui__button {
      @apply w-full rounded-md bg-primary-50 px-3.5 py-2.5 text-sm font-semibold text-primary-600 shadow-xs hover:bg-primary-100 dark:bg-primary-500/20 dark:text-primary-400 dark:shadow-none dark:hover:bg-primary-500/30;
    }

    .pagefind-ui__result-thumb {
      position: relative;
    }

    .pagefind-ui__result-image {
      display: block;
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
    }

    .pagefind-ui__result-inner {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
    }

    .pagefind-ui__result-title {
      display: inline-block;
    }

    .pagefind-ui__result-excerpt {
      display: inline-block;
    }

    .pagefind-ui__result-tags {
      display: flex;
      flex-wrap: wrap;
    }
  }

  /*
   * @pagefind/default-ui's Svelte component injects its own <style> into
   * <head> at runtime (after this stylesheet), setting both the input's
   * background and `::placeholder { opacity: 0.2 }` regardless of theme or
   * the input's own text colour. Without `!important` those rules land
   * after ours in source order and win on the tie, which is why the
   * `dark:bg-white/5` utility on `.pagefind-ui__search-input` never actually
   * applies - measured in the browser, the input's background stays solid
   * white (`rgb(255, 255, 255)`) in both themes. So there is no dark variant
   * here: gray-600 against that white background clears 4.5:1 in light and
   * dark mode alike. The `.pagefind-ui__form` ancestor raises specificity
   * above Pagefind's own single-class rule, and `!important` guarantees this
   * wins regardless of when Pagefind's rule lands (#1835).
   */
  .pagefind-ui__form .pagefind-ui__search-input::placeholder {
    color: var(--color-gray-600) !important;
    opacity: 100% !important;
  }
</style>
