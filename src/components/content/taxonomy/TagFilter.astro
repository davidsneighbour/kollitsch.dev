---
// @todo refactor and comment
export interface Props {
  filterId?: string;
  note?: string;
  placeholder?: string;
}

const {
  filterId = 'default',
  note,
  placeholder = 'Search tags...',
} = Astro.props;
const safeFilterId = String(filterId).replace(/[^a-zA-Z0-9_-]/g, '-');
const inputId = `tag-filter-input-${safeFilterId}`;
---

<div
  class="tag-filter"
  data-tag-filter
  data-tag-filter-id={filterId}
>
  <label
    class="sr-only"
    for={inputId}
    >Filter tags</label
  >

  <input
    id={inputId}
    type="search"
    inputmode="search"
    autocomplete="off"
    spellcheck="false"
    placeholder={placeholder}
    class="h-9 w-full min-w-0 rounded-md border border-input bg-transparent px-3 py-1 text-base shadow-xs transition-[color,box-shadow] outline-none selection:bg-primary selection:text-primary-foreground placeholder:text-muted-foreground disabled:pointer-events-none disabled:cursor-not-allowed disabled:opacity-50 md:text-sm dark:bg-input/30 focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 aria-invalid:border-destructive aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40"
    data-tag-filter-input
  >

  {note ? <p class="mt-2 text-sm text-muted-foreground">{note}</p> : null}

  <div
    class="mt-2 text-xs text-muted-foreground"
    data-tag-filter-status
    aria-live="polite"
  ></div>
</div>

<script>
  /**
   * Returns true if every character in `needle` can be found in order within `haystack`.
   * Example: needle "koll" matches haystack "kollitsch".
   */
  function fuzzyInOrder(haystack: string, needle: string): boolean {
    if (needle.length === 0) return true;
    let i = 0;
    for (let j = 0; j < haystack.length; j += 1) {
      if (haystack[j] === needle[i]) i += 1;
      if (i === needle.length) return true;
    }
    return false;
  }

  /**
   * Same in-order matching as fuzzyInOrder, but returns the matched
   * character positions in `haystack` so callers can highlight only the
   * characters that actually matched. A contiguous run of indices reads as
   * a "real" match; scattered indices read as a fuzzy one, so highlighting
   * alone visually tells the two apart without extra UI.
   *
   * Matches greedily from the right (last needle character to first),
   * picking the latest possible occurrence of each character. This tends
   * to cluster the highlighted positions around the last, most complete
   * run in the haystack (e.g. needle "how" against "john-lithgow"
   * highlights the "h" in "lithgow" rather than the "h" in "john").
   */
  function fuzzyMatchPositions(
    haystack: string,
    needle: string,
  ): number[] | null {
    if (needle.length === 0) return [];
    const positions: number[] = new Array(needle.length);
    let i = needle.length - 1;
    for (let j = haystack.length - 1; j >= 0 && i >= 0; j -= 1) {
      if (haystack[j] === needle[i]) {
        positions[i] = j;
        i -= 1;
      }
    }
    return i < 0 ? positions : null;
  }

  function escapeSelector(value: string): string {
    if (typeof CSS !== 'undefined' && typeof CSS.escape === 'function') {
      return CSS.escape(value);
    }
    return value.replace(/["\\]/g, '\\$&');
  }

  function initTagFilter(root: HTMLElement): void {
    const input = root.querySelector('[data-tag-filter-input]');
    const status = root.querySelector('[data-tag-filter-status]');
    const filterId = root.getAttribute('data-tag-filter-id') ?? 'default';

    if (!(input instanceof HTMLInputElement)) {
      console.error('tag-filter: input not found or wrong type', { root });
      return;
    }

    const selector = `[data-tag-filter-list][data-tag-filter-id="${escapeSelector(filterId)}"]`;
    const lists = Array.from(document.querySelectorAll<HTMLElement>(selector));
    const links = lists.flatMap((list) =>
      Array.from(list.querySelectorAll<HTMLAnchorElement>('a[data-label]')),
    );
    const defaultVisibleCount = links.filter(
      (link) => link.getAttribute('data-tag-filter-default-hidden') !== 'true',
    ).length;

    // Original, un-highlighted text of each tag's label span, captured once
    // so highlights can be rebuilt from scratch on every keystroke.
    const labelSpans = new Map<HTMLAnchorElement, HTMLElement>();
    const originalLabelText = new Map<HTMLElement, string>();
    for (const a of links) {
      const span = a.querySelector<HTMLElement>('[data-tag-label]');
      if (span) {
        labelSpans.set(a, span);
        originalLabelText.set(span, span.textContent ?? '');
      }
    }

    const markMatch = (a: HTMLAnchorElement, label: string, query: string) => {
      const span = labelSpans.get(a);
      if (!span) return;
      const original = originalLabelText.get(span) ?? '';

      const offset = original.toLowerCase().indexOf(label);
      if (offset === -1) {
        span.textContent = original;
        return;
      }

      // A real (contiguous) match highlights as one solid run; only fall
      // back to the scattered fuzzy positions when there is no literal
      // substring match to prefer.
      const substringIndex = label.indexOf(query);
      const positions =
        substringIndex === -1
          ? fuzzyMatchPositions(label, query)
          : Array.from({ length: query.length }, (_, k) => substringIndex + k);

      if (!positions || positions.length === 0) {
        span.textContent = original;
        return;
      }

      const frag = document.createDocumentFragment();
      let cursor = 0;
      for (const pos of positions) {
        const spanIndex = offset + pos;
        frag.append(original.slice(cursor, spanIndex));
        const mark = document.createElement('mark');
        mark.className = 'rounded-sm bg-primary-300/70 text-inherit dark:bg-primary-400/40';
        mark.textContent = original[spanIndex] ?? '';
        frag.append(mark);
        cursor = spanIndex + 1;
      }
      frag.append(original.slice(cursor));
      span.replaceChildren(frag);
    };

    const apply = (q: string) => {
      const query = q.trim().toLowerCase();
      const isSearching = query !== '';
      let visible = 0;

      for (const a of links) {
        const label = (a.getAttribute('data-label') ?? '').toLowerCase();
        const hiddenByDefault =
          a.getAttribute('data-tag-filter-default-hidden') === 'true';
        const match = isSearching ? fuzzyInOrder(label, query) : !hiddenByDefault;
        a.hidden = !match;
        if (match) visible += 1;

        if (isSearching && match) {
          markMatch(a, label, query);
        } else {
          const span = labelSpans.get(a);
          if (span) span.textContent = originalLabelText.get(span) ?? '';
        }
      }

      if (status instanceof HTMLElement) {
        const total = query === '' ? defaultVisibleCount : links.length;
        status.textContent =
          links.length === 0 ? '' : `${visible} / ${total} tags`;
      }
    };

    // Initial render
    apply(input.value);

    // Avoid double-binding if Astro swaps pages
    if (input.dataset['tagFilterBound'] === 'true') return;
    input.dataset['tagFilterBound'] = 'true';
    const handler = () => apply(input.value);
    input.addEventListener('input', handler, { passive: true });
  }

  function boot() {
    const roots = document.querySelectorAll('[data-tag-filter]');
    for (const el of roots) {
      if (el instanceof HTMLElement) initTagFilter(el);
    }
  }

  document.addEventListener('astro:page-load', boot);
  // Also run once for non-router loads
  boot();
</script>
