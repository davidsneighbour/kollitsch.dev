---
// @todo refactor and comment
import type { CollectionEntry } from 'astro:content';
import PostImage from '@components/content/media/PostImage.astro';
import SchemaBlogPost from '@components/seo/schema/BlogPosting.astro';
import Button from '@components/shared/elements/Button.astro';
import { getPostPreviewTransitionName } from '@utils/view-transitions';

export interface Props {
  post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;
const transitionName = getPostPreviewTransitionName(post.id);
---

<article
  transition:name={transitionName}
  data-post-preview-transition={transitionName}
  class="group @container relative isolate flex flex-col justify-normal rounded-(--card-radius) bg-card p-(--card-padding) text-card-foreground shadow-sm ring-1 ring-gray-900/10 [--card-padding:--spacing(1)] [--card-radius:var(--radius-lg)] ring-inset transition-colors duration-300 ease-in-out hover:bg-white dark:bg-black/20 dark:text-gray-200 dark:shadow-none dark:ring-gray-100/10 dark:hover:bg-black/30"
>
  <PostImage
    post={post}
    link={`/blog/${post.id}/`}
    classes="aspect-dnb max-w-full object-cover rounded-t-[calc(var(--card-radius)-var(--card-padding))]"
    quality="medium"
  />
  <div class="flex grow flex-col justify-start @sm:p-2 @md:p-3 @lg:p-4">
    <h2
      class="mt-0 flex-none text-lg @md:text-xl @lg:text-2xl @xl:text-3xl @2xl:text-4xl @3xl:text-5xl @4xl:text-6xl"
    >
      <a
        class="line-clamp-2 no-underline underline-offset-2 group-hover:underline group-hover:decoration-1 hover:decoration-2"
        href={`/${post.collection}/${post.id}/`}
        set:html={post.data.title}
        data-astro-prefetch="viewport"
      />
    </h2>
    <p
      class="@md:text-md line-clamp-3 text-base @lg:text-lg @xl:text-xl @2xl:text-2xl @3xl:text-3xl @4xl:text-4xl"
      set:html={post.data.summary}
    />
  </div>
  <div class="flex-none px-4 pb-4 text-right">
    <Button
      theme="primary"
      outline
      name="arrow-right"
      href={`/${post.collection}/${post.id}/`}
      classes="justify-self-end"
      >Read more...</Button
    >
  </div>
</article>
<SchemaBlogPost post={post} />
