---
export interface Props {
  class?: string;
}

const { class: className = '' }: Props = Astro.props;
---

{/* `relative` makes the reading column the containing block for in-text
    tooltips (archived-link markers), so their anchor-position fallbacks
    keep them inside the column instead of under the card's clipped edge. */}
<div class:list={['typography-reading relative', className]}>
  <slot />
</div>
