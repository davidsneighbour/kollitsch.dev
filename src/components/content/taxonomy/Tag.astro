---
import Badge from '@components/shared/elements/Badge.astro';
import type { TagBadge, TagIcon } from '@utils/tags.ts';
import { Icon } from 'astro-icon/components';

export interface Props {
  href: string;
  label: string;
  dataLabel: string;
  badge?: TagBadge;
  hidden?: boolean;
  icon?: TagIcon | string;
  style?: string;
  title?: string;
  dataTagFilterDefaultHidden?: string;
}

const {
  href,
  label,
  dataLabel,
  badge,
  hidden,
  icon,
  style,
  title,
  dataTagFilterDefaultHidden,
} = Astro.props;
const iconConfig: TagIcon | undefined =
  badge?.icon ?? (typeof icon === 'string' ? { name: icon } : icon);
const iconName = iconConfig?.name;
const iconColor = iconConfig?.color;
const iconPosition = iconConfig?.position ?? 'inline-start';
const badgeProps = {
  href,
  ...(badge?.variant ? { variant: badge.variant } : {}),
  ...(badge?.class ? { class: badge.class } : {}),
  ...(title ? { title } : {}),
  'data-label': dataLabel,
  ...(dataTagFilterDefaultHidden
    ? { 'data-tag-filter-default-hidden': dataTagFilterDefaultHidden }
    : {}),
  ...(hidden !== undefined ? { hidden } : {}),
  ...(style ? { style } : {}),
};
---

<Badge {...badgeProps}>
  {iconName && iconPosition === "inline-start" && (
    <Icon
      name={iconName}
      data-icon="inline-start"
      style={iconColor ? `color: ${iconColor};` : undefined}
    />
  )}
  {label}
  {iconName && iconPosition === "inline-end" && (
    <Icon
      name={iconName}
      data-icon="inline-end"
      style={iconColor ? `color: ${iconColor};` : undefined}
    />
  )}
</Badge>
