---
// @todo refactor and comment
import { Image } from 'astro:assets';
import patrickkollitsch from '@assets/images/patrick-kollitsch.png';
import Heading from '@components/content/typography/Heading.astro';
import type { SocialMediaItem } from '@components/features/social/SocialLinks.astro';
import SocialLinks from '@components/features/social/SocialLinks.astro';
import Colophon from '@components/layout/footer/Colophon.astro';
import Icon from '@components/shared/elements/Icon.astro';
import IconLink from '@components/shared/links/IconLink.astro';
import Link from '@components/shared/links/Link.astro';
import rawSocialMediaData from '@content/social.json' with { type: 'json' };
import rawNavData from '@data/footernavigation.json' with { type: 'json' };
import setup from '@data/setup.json' with { type: 'json' };
import Wordmark from '@dnbhq/wordmark';
import { getHomepageUrl } from '@utils/content';
import type { Navigation } from '@utils/navigation';
import MarkdownIt from 'markdown-it';

export interface Props {}

const socialMediaData = rawSocialMediaData as SocialMediaItem[];
const footerYearId = 'footer-current-year';
const currentYear = new Date().getFullYear().toString();
const navData = rawNavData as Navigation;
const md = new MarkdownIt();
const introFallback = setup.introduction.replace('{$greeting}', '').trim();
const introFallbackHtml = md.renderInline(introFallback);
---

<footer
  class={setup.classes.containers.wide}
  aria-label="Footer"
>
  <Heading
    level={2}
    class="sr-only"
  >
    Footer section with navigation and social media links
  </Heading>
  <div
    class="mt-8 mb-8 grid grid-cols-1 gap-8 border-t border-t-gray-700 bg-olive-50 py-8 md:grid-cols-2 lg:grid-cols-9 xl:grid-cols-7 dark:bg-olive-950"
  >
    <aside
      class="py-4 text-center md:col-span-2 lg:col-span-5 lg:text-left xl:col-span-4"
      aria-label="About section with author image and introduction"
    >
      <Heading
        level={3}
        class="mb-4 border-b border-gray-100 dark:border-gray-900"
      >
        About
      </Heading>
      <div class="about-intro text-left">
        <Link
          href="/connect/"
          class="about-intro__image"
        >
          <Image
            src={patrickkollitsch}
            alt="Patrick Kollitsch"
            width={256}
            height={256}
            loading="lazy"
            class="about-intro__image-element border border-gray-200 dark:border-gray-800"
          />
        </Link>
        <div
          id="about-introduction"
          set:html={introFallbackHtml}
        />
      </div>
    </aside>
    <aside
      class="py-4 lg:col-span-2 xl:col-span-1"
      aria-label="Site navigation links"
    >
      <Heading
        level={3}
        class="mb-4 border-b border-gray-100 text-center dark:border-gray-900"
      >
        Navigation
      </Heading>
      <ul
        class="flex flex-row flex-wrap justify-center gap-2 text-center lg:flex-col lg:justify-end"
      >
        {navData.map((value) => (
            <li>
              <IconLink href={value.link} icon={value.icon} linkClass="justify-center">
                {value.label}
              </IconLink>
            </li>
          ))}
      </ul>
    </aside>
    <aside
      class="py-4 lg:col-span-2"
      aria-label="Social media links"
    >
      <Heading
        level={3}
        class="mb-4 border-b border-gray-100 text-center lg:text-right dark:border-gray-900"
      >
        Connect
      </Heading>
      <SocialLinks items={socialMediaData} />
    </aside>
  </div>

  <div
    class="flex flex-col items-center justify-between border-t border-gray-800 pt-6 md:flex-row"
  >
    <span class="text-center md:text-left"
      >&copy; 2021 &ndash; <span id={footerYearId}>{currentYear}</span>
      <a href={getHomepageUrl()}>{setup.title}</a>
      <span
        id="site-version"
        aria-live="polite"
        aria-atomic="true"
      ></span>
    </span>
    <span class="text-center">All rights reserved.</span>
    <span class="text-center lg:text-right"
      >Another production by
      <Wordmark
        inline
        color="var(--footer-wordmark-color)"
      /></span
    >
  </div>

  <div class="my-4 flex flex-row items-center justify-center gap-8 text-sm">
    <IconLink
      href="/privacy-policy/"
      icon="lucide:shield-check"
    >
      Privacy Policy
    </IconLink>
    <IconLink
      href="/security-policy/"
      icon="lucide:fingerprint-pattern"
    >
      Security Policy
    </IconLink>
  </div>

  <div
    class="my-4 flex flex-col md:flex-row items-center justify-center gap-2 text-sm"
  >
    <div
      id="webring-mention"
      class="text-center"
    >
      A member of the <a href="https://static.quest">Static.Quest</a> web ring!
    </div>
    <div class="flex flex-row items-center justify-center gap-2">
      <IconLink
        href="https://static.quest/previous/?host=kollitsch.dev"
        icon="lucide:chevron-left"
        aria-label="Previous site in the Static.Quest web ring"
      />
      <a href="https://static.quest/members">View Members</a>
      <IconLink
        href="https://static.quest/next/?host=kollitsch.dev"
        icon="lucide:chevron-right"
        iconPosition="postfix"
        aria-label="Next site in the Static.Quest web ring"
      />
      <a href="https://static.quest/random">Feeling lucky?</a>
    </div>
  </div>

  <div class="my-4 flex flex-row items-center justify-center gap-2 text-sm">
    <Icon name="lucide:rss" />
    <Link href="/rss.xml">RSS</Link>
    <Link href="/atom.xml">Atom</Link>
    <Link href="/feed.json">JSON</Link>
  </div>

  <script
    is:inline
    define:vars={{ footerYearId }}
    data-astro-rerun
  >
    document.getElementById(footerYearId).innerText = new Date().getFullYear();

    (async () => {
      try {
        const el = document.getElementById('site-version');
        if (!el) return;
        const resp = await fetch('/api/siteinfo.json');
        if (!resp.ok) return;
        const data = await resp.json();
        const version = data?.version ?? null;
        const releasePage = data?.releasePage ?? null;
        if (version && releasePage) {
          el.textContent = '';
          const separator = document.createTextNode(' ៚ ');
          const link = document.createElement('a');
          Object.assign(link, {
            href: releasePage,
            rel: 'noopener noreferrer',
            target: '_blank',
            textContent: `v${version}`,
          });
          el.appendChild(separator);
          el.appendChild(link);
        }
      } catch (err) {
        // silence failures; footer should not break if API is unavailable
      }
    })();
  </script>

  <script>
    import setup from '@data/setup.json' with { type: 'json' };
    import MarkdownIt from 'markdown-it';

    const md = new MarkdownIt();

    /**
     * Render the introduction with a time-based greeting.
     */
    export function renderIntroduction(
      introRaw: string,
      greetings: Record<string, string>,
    ): string {
      const hour = new Date().getHours();
      const greeting =
        hour >= 5 && hour < 12
          ? greetings['morning']
          : hour >= 12 && hour < 17
            ? greetings['afternoon']
            : hour >= 17 && hour < 21
              ? greetings['evening']
              : hour >= 21 || hour < 5
                ? greetings['night']
                : greetings['default'];

      const introFinal = introRaw.replace('{$greeting}', greeting ?? '');
      return md.renderInline(introFinal);
    }

    const target = document.getElementById('about-introduction');
    if (target) {
      const html = renderIntroduction(setup.introduction, setup.greetings);
      target.innerHTML = html;
    }
  </script>

  <style>
    footer {
      --footer-wordmark-color: var(--color-primary-700);
    }

    :where([data-theme="dark"]) footer {
      --footer-wordmark-color: var(--color-primary-600);
    }

    /*
     * The wordmark is an <a> from the @dnbhq/wordmark package, styled via its
     * `color` prop as a CSS variable reference (see the `footer` rule above),
     * so it can react to hover the same way the site's other nav links do
     * (NavItem.astro: primary-700/600 in light, primary-600/400 in dark)
     * instead of staying a flat, unhoverable brand color.
     */
    /* stylelint-disable-next-line selector-pseudo-class-no-unknown */
    :global(.dnb-wordmark) {
      transition: color 150ms ease;
    }

    /* stylelint-disable-next-line selector-pseudo-class-no-unknown */
    :global(.dnb-wordmark:hover) {
      --footer-wordmark-color: var(--color-primary-600);
    }

    /* stylelint-disable-next-line selector-pseudo-class-no-unknown */
    :where([data-theme="dark"]) :global(.dnb-wordmark:hover) {
      --footer-wordmark-color: var(--color-primary-400);
    }

    .about-intro {
      text-align: justify;
    }

    /*
     * The site's global links rely on color alone at rest (underline only
     * appears on hover - see DESIGN.md's "Links (prose)" section), which is
     * fine against a page background but fails WCAG 1.4.1 (Use of Color) for
     * links embedded inside a paragraph of body text: axe's link-in-text-block
     * rule flagged these against the surrounding text color at 2.89:1, just
     * under the 3:1 non-text-contrast threshold (#1835). Scoped underline
     * here, rather than changing the site-wide hover-only convention, since
     * these are the only places links sit inline in a prose sentence.
     */
    /* stylelint-disable-next-line selector-pseudo-class-no-unknown */
    #about-introduction :global(a),
    #webring-mention a {
      text-decoration-line: underline;
    }

    .about-intro__image {
      float: left;
      height: 14rem;
      width: 14rem;

      /*
       * Break the avatar 30% out of the text column to the left. This moves
       * the actual floated box (not just a visual transform), so
       * `shape-outside` and the surrounding text reflow around the new
       * position instead of the image overlapping already-wrapped text.
       */
      margin: 1rem 1rem 1rem -4.2rem;

      /*
       * `circle()` defaults to wrapping the margin-box. With an asymmetric
       * (negative-left, positive-right) margin that box is no longer square,
       * so its center drifts from the visual circle and text creeps over the
       * border. Pin the shape to the border-box, which matches the rounded
       * image exactly regardless of margin.
       */
      shape-outside: circle() border-box;
      shape-margin: 1rem;
    }

    .about-intro__image-element {
      display: block;
      height: 100%;
      width: 100%;
      border-radius: 0 9999px 9999px 0;
    }

    @media (max-width: 767px) {
      .about-intro__image {
        float: left;
        height: 10rem;
        width: 10rem;

        /* Smaller, fixed breakout on mobile so the face stays in the viewport. */
        margin: 0 0.75rem 0.5rem -25px;
        shape-outside: circle() border-box;
      }

      /* Keep the text (not the image, which intentionally breaks out) off the viewport edge. */
      #about-introduction {
        padding-inline: 1em;
      }
    }
  </style>
</footer>

<Colophon />
