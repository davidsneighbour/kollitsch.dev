{
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/markdown-remark": "7.3.1",
    "@astrojs/mdx": "8.0.1",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/ts-plugin": "1.10.11",
    "@sentry/astro": "10.74.0",
    "@spotlightjs/astro": "3.2.6",
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindplus/elements": "1.0.22",
    "@types/markdown-it": "14.2.0",
    "@types/mdast": "4.0.4",
    "@types/yargs": "17.0.35",
    "astro": "7.3.2",
    "astro-expressive-code": "0.44.2",
    "fast-glob": "3.3.3",
    "gray-matter": "4.0.3",
    "js-yaml": "5.4.2",
    "remark-definition-list": "2.0.0",
    "remark-kbd-nested": "0.6.1",
    "tailwindcss": "4.3.3",
    "unist-util-visit": "5.1.0",
    "tsx": "4.23.13",
    "vite-plugin-devtools-json": "1.1.0",
    "@tailwindcss/vite": "4.3.3",
    "tw-animate-css": "1.4.0",
    "@astrojs/markdown-satteri": "0.4.1",
    "@types/node": "26.5.1"
  },
  "scripts": {
    "astro": "astro",
    "build": "wireit",
    "build:check": "wireit",
    "build:clean": "wireit",
    "build:compile": "wireit",
    "build:profile": "DEBUG=astro:build,OpenGraphImage npx astro build --verbose | tee .cache/build.log",
    "build:prototypes": "wireit",
    "build:prune-prototypes": "wireit",
    "build:prune-test": "wireit",
    "check": "wireit",
    "check:scripts": "tsc --noEmit --project tsconfig.scripts.json",
    "clean:astro": "wireit",
    "clean:build-caches": "wireit",
    "clean:og": "wireit",
    "create:blog": "node src/scripts/content/create-blog-post.ts",
    "dev": "npm run dev:watch",
    "dev:certs": "mkcert -install && mkdir -p .certs && mkcert -cert-file .certs/localhost.pem -key-file .certs/localhost-key.pem localhost 127.0.0.1 ::1 192.168.1.201",
    "dev:docs": "node src/scripts/documentation-server.ts",
    "dev:open": "node src/scripts/dev-open.ts",
    "dev:site": "astro dev",
    "dev:verbose": "DEBUG_FRONTMATTER=true astro dev --verbose",
    "dev:watch": "node src/scripts/webserver.ts",
    "preview": "astro preview",
    "upgrade": "npx @astrojs/upgrade"
  },
  "wireit": {
    "build": {
      "command": "npm run docs:api",
      "dependencies": [
        "build:prune-prototypes"
      ]
    },
    "build:check": {
      "command": "astro check"
    },
    "build:clean": {
      "command": "npm run build",
      "dependencies": [
        "clean:build-caches"
      ]
    },
    "build:compile": {
      "command": "astro build",
      "dependencies": [
        "build:check"
      ]
    },
    "build:prototypes": {
      "command": "KOLLITSCH_INCLUDE_PROTOTYPES=1 npm run build"
    },
    "build:prune-prototypes": {
      "command": "node src/scripts/build/prune-prototypes.ts",
      "dependencies": [
        "build:prune-test"
      ]
    },
    "build:prune-test": {
      "command": "rm -rf dist/test/",
      "dependencies": [
        "build:compile"
      ]
    },
    "check": {
      "command": "npm run check:scripts",
      "dependencies": [
        "build:check",
        "check:ogimages"
      ]
    },
    "check:ogimages": {
      "command": "node src/scripts/build/build-og-images.ts --check"
    },
    "clean:astro": {
      "command": "rm -rf .astro dist node_modules/.astro"
    },
    "clean:build-caches": {
      "command": "rm -rf .astro node_modules/.astro .cache/image-index .cache/social-images"
    },
    "clean:og": {
      "command": "rm -rf .cache/social-images"
    }
  },
  "overrides": {
    "gray-matter": {
      "js-yaml": "3.15.2"
    },
    "svgo": "4.1.0"
  }
}
