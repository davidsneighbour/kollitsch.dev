---
import { mergePropsWithDefaults } from '@utils/content.ts';
import type { TagListItem } from '@utils/tags.ts';
import Tag from './Tag.astro';

export interface Props {
  tags: TagListItem[] | Map<string, number>;
  searchTags?: TagListItem[];
  minSize?: number;
  maxSize?: number;
  showCounts?: boolean;
  filterId?: string;
}

const props = mergePropsWithDefaults(Astro.props as Props, {
  filterId: 'default',
  maxSize: 2.0, // rem
  minSize: 0.75, // rem
  showCounts: true,
}) as Required<
  Pick<Props, 'filterId' | 'maxSize' | 'minSize' | 'showCounts' | 'tags'>
>;

const visibleItems: TagListItem[] =
  props.tags instanceof Map
    ? Array.from(props.tags.entries()).map(([tag, count]) => ({
        count,
        hideInTagCloud: false,
        id: tag,
        label: tag,
        url: `/tags/${encodeURIComponent(tag)}/`,
        weight: 0,
      }))
    : props.tags;

const visibleKeys = new Set(
  visibleItems.map((item) => `${item.url}|${item.label}`),
);

const items = (Astro.props.searchTags ?? visibleItems).map((item) => ({
  ...item,
  hiddenByDefault: !visibleKeys.has(`${item.url}|${item.label}`),
}));

const counts = visibleItems.map((item) => item.count);
const maxCount = Math.max(...counts, 0);
const minCount = Math.min(...counts, 0);

function getFontSize(count: number, hiddenByDefault: boolean): string {
  if (hiddenByDefault) return '1rem';

  const weight = (count - minCount) / (maxCount - minCount || 1);
  const size = props.minSize + weight * (props.maxSize - props.minSize);
  return `${size.toFixed(2)}rem`;
}
---

<div
  class="mt-2 flex flex-wrap items-baseline gap-x-4 gap-y-3"
  data-tag-filter-list
  data-tag-filter-id={props.filterId}
>
  {items.length === 0 ? (
      <span>(none)</span>
    ) : (
      items.map((tag) => (
      <Tag
        href={tag.url}
        label={`#${props.showCounts ? `${tag.label} (${tag.count})` : tag.label}`}
        dataLabel={String(tag.label).toLowerCase()}
        title={`${tag.count} posts`}
        hidden={tag.hiddenByDefault}
        style={`font-size: ${getFontSize(tag.count, tag.hiddenByDefault)}; line-height: 1.1;`}
        {...(tag.hiddenByDefault && { dataTagFilterDefaultHidden: 'true' })}
        {...(tag.badge && { badge: tag.badge })}
        {...(tag.icon && { icon: tag.icon })}
      />
      ))
    )}
</div>
