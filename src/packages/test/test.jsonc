{
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "@vitest/ui": "5.1.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "cheerio": "1.2.0",
    "vitest": "5.1.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npx playwright test --tsconfig ./tsconfig.playwright.json",
    "test:e2e:ui": "npx playwright test --ui --tsconfig ./tsconfig.playwright.json",
    "test:install-browsers": "npx playwright install",
    "test:live": "npx playwright test --config ./playwright.live.config.ts --tsconfig ./tsconfig.playwright.json",
    "test:ui": "vitest --ui"
  },
  "wireit": {}
}
