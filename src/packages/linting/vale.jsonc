{
  "scripts": {
    "lint:vale": "vale --config src/config/.vale.ini --no-exit --output=line ./src/content/",
    "lint:vale:file": "vale --config src/config/.vale.ini --output=line",
    "report:vale:blog": "node src/scripts/linting/vale-report.ts --target=src/content/blog --json=reports/vale/vale-blog.json --html=reports/vale/vale-blog.html --open",
    "update:pre:vale": "wireit"
  },
  "wireit": {
    "update:pre:vale": {
      "command": "vale --config src/config/.vale.ini --no-exit sync"
    }
  }
}
