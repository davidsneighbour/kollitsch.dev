{
  "devDependencies": {
    "@netlify/functions": "5.3.0"
  },
  "scripts": {
    "clean:netlify": "wireit",
    "deploy": "node src/scripts/maintenance/timed-run.ts --label \"npm run deploy\" -- wireit",
    "deploy:build": "wireit",
    "deploy:release": "wireit"
  },
  "wireit": {
    "clean:netlify": {
      "command": "find .netlify -type f ! -name \".gitignore\" -delete"
    },
    "deploy": {
      "command": "bash -c 'netlify deploy --message \"v$(node -p \"require(\\\"./package.json\\\").version\")\" --created-via=release --prod --open'",
      "dependencies": [
        "deploy:build"
      ]
    },
    "deploy:build": {
      "command": "npm run build",
      "dependencies": [
        "deploy:release"
      ]
    },
    "deploy:release": {
      "command": "npm run release",
      "dependencies": [
        "check"
      ]
    }
  }
}
