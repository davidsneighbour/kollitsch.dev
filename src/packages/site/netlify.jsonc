{
  "devDependencies": {
    "@netlify/functions": "6.0.0"
  },
  "scripts": {
    "clean:netlify": "wireit",
    "deploy": "node src/scripts/maintenance/timed-run.ts --label \"npm run deploy\" -- npm run deploy:pipeline",
    "deploy:preview": "node src/scripts/maintenance/timed-run.ts --label \"npm run deploy:preview\" -- npm run deploy:preview:pipeline",
    "deploy:preview:build": "wireit",
    "deploy:preview:pipeline": "wireit",
    "deploy:preview:prototypes": "node src/scripts/maintenance/timed-run.ts --label \"npm run deploy:preview:prototypes\" -- npm run deploy:preview:prototypes:pipeline",
    "deploy:preview:prototypes:build": "wireit",
    "deploy:preview:prototypes:pipeline": "wireit",
    "deploy:pipeline": "wireit",
    "deploy:build": "wireit",
    "deploy:release": "wireit"
  },
  "wireit": {
    "clean:netlify": {
      "command": "find .netlify -type f ! -name \".gitignore\" -delete"
    },
    "deploy:preview:pipeline": {
      "command": "netlify deploy --dir dist --no-build --context deploy-preview --created-via=manual --message \"test preview\"",
      "dependencies": [
        "deploy:preview:build"
      ]
    },
    "deploy:preview:build": {
      "command": "npm run build"
    },
    "deploy:preview:prototypes:pipeline": {
      "command": "netlify deploy --dir dist --no-build --context deploy-preview --created-via=manual --message \"prototype preview\"",
      "dependencies": [
        "deploy:preview:prototypes:build"
      ]
    },
    "deploy:preview:prototypes:build": {
      "command": "KOLLITSCH_INCLUDE_PROTOTYPES=1 npm run build"
    },
    "deploy:pipeline": {
      "command": "bash -c 'netlify deploy --message \"v$(node -p \"require(\\\"./package.json\\\").version\")\" --created-via=release --prod --open'",
      "dependencies": [
        "deploy:build"
      ]
    },
    "deploy:build": {
      "command": "npm run build",
      "dependencies": [
        "check"
      ]
    }
  }
}
