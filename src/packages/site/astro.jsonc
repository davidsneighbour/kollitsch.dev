{
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/markdown-remark": "7.2.2",
    "@astrojs/mdx": "7.0.5",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "@astrojs/ts-plugin": "1.10.10",
    "@iconify-json/bi": "1.2.7",
    "@sentry/astro": "10.69.0",
    "@spotlightjs/astro": "3.2.6",
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindplus/elements": "1.0.22",
    "@types/markdown-it": "14.1.2",
    "@types/mdast": "4.0.4",
    "@types/yargs": "17.0.35",
    "astro": "7.2.0",
    "astro-expressive-code": "0.44.1",
    "astro-icon": "1.1.5",
    "fast-glob": "3.3.3",
    "gray-matter": "4.0.3",
    "js-yaml": "4.3.1",
    "remark-definition-list": "2.0.0",
    "remark-kbd-nested": "0.6.1",
    "tailwindcss": "4.3.3",
    "unist-util-visit": "5.1.0",
    "tsx": "4.23.11",
    "vite-plugin-devtools-json": "1.1.0",
    "@tailwindcss/vite": "4.3.3",
    "tw-animate-css": "1.4.0",
    "@astrojs/markdown-satteri": "0.3.5",
    "@types/node": "26.2.0"
  },
  "scripts": {
    "astro": "astro",
    "build": "astro check && astro build && rm -rf dist/test/ && npm run docs:api",
    "build:clean": "npm run clean:build-caches && npm run build",
    "build:profile": "DEBUG=astro:build,OpenGraphImage npx astro build --verbose | tee .cache/build.log",
    "check": "astro check && npm run check:scripts",
    "check:scripts": "tsc --noEmit --project tsconfig.scripts.json",
    "clean:astro": "wireit",
    "clean:build-caches": "wireit",
    "clean:og": "wireit",
    "create:blog": "node src/scripts/content/create-blog-post.ts",
    "dev": "npm run dev:watch",
    "dev:certs": "mkcert -install && mkdir -p .certs && mkcert -cert-file .certs/localhost.pem -key-file .certs/localhost-key.pem localhost 127.0.0.1 ::1",
    "dev:docs": "node src/scripts/documentation-server.ts",
    "dev:open": "node src/scripts/dev-open.ts",
    "dev:site": "astro dev",
    "dev:verbose": "DEBUG_FRONTMATTER=true astro dev --verbose",
    "dev:watch": "node src/scripts/webserver.ts",
    "preview": "astro preview",
    "upgrade": "npx @astrojs/upgrade"
  },
  "wireit": {
    "clean:astro": {
      "command": "rm -rf .astro dist node_modules/.astro"
    },
    "clean:build-caches": {
      "command": "rm -rf .astro node_modules/.astro public/og_image .cache/og_image .cache/image-index"
    },
    "clean:og": {
      "command": "rm -rf public/og_image .cache/og_image"
    }
  },
  "overrides": {
    "gray-matter": {
      "js-yaml": "3.15.1"
    }
  }
}
