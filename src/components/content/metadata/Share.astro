---
import type { CollectionEntry } from 'astro:content';
import ShareIntentLink from '@components/features/social/ShareIntentLink.astro';
import Icon from '@components/shared/elements/Icon.astro';
import { socialNetworksFor } from '@data/social.ts';

export interface Props {
  post: CollectionEntry<'blog'>;
}

const { post }: Props = Astro.props;

// @todo rework Props so we pass url, title, description instead of the whole post
const shareValues = {
  description: post.data.description ?? '',
  title: post.data.title,
  url: Astro.url.toString(),
};
const shareNetworks = socialNetworksFor('shareMeta');
---

<div class="flex flex-row items-center justify-start gap-2">
  <div class="w-6 flex-none">
    <Icon name="lucide:share-2" />
  </div>
  <div class="flex flex-row flex-wrap items-center justify-start gap-2">
    <span>Share:</span>
    {shareNetworks.map((network) => (
      <>
        <Icon name={network.icon} aria-hidden="true" />
        <ShareIntentLink
          share={network.share!}
          values={shareValues}
          target="_blank"
          rel="noopener"
          class="inline-block px-1 py-1"
        >
          {network.label}
        </ShareIntentLink>
      </>
    ))}
  </div>
</div>
